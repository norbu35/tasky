{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasky.local/schemas/self-verify.schema.json",
  "title": "Tasky Self-Verification Report",
  "description": "Canonical artifact schema for pre-commit and pre-push self-verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "ticket",
    "risk_level",
    "ticket_spec_path",
    "req_ids",
    "files_changed",
    "required_check_ids",
    "checks",
    "acceptance_criteria",
    "ac_test_mapping",
    "ac_coverage_summary",
    "overall_status",
    "known_risks",
    "assumptions",
    "self_critique",
    "ci_parity",
    "git_context",
    "agent"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ticket": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "ticket_spec_path": {
      "type": "string",
      "minLength": 1
    },
    "req_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(REQ|NFR)-[A-Z]+-[0-9]+$"
      }
    },
    "files_changed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_check_ids": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/checkId"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/checkResult"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    },
    "ac_test_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acMapping"
      }
    },
    "ac_coverage_summary": {
      "$ref": "#/$defs/acCoverageSummary"
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "self_critique": {
      "$ref": "#/$defs/selfCritique"
    },
    "ci_parity": {
      "$ref": "#/$defs/ciParity"
    },
    "git_context": {
      "$ref": "#/$defs/gitContext"
    },
    "agent": {
      "$ref": "#/$defs/agentContext"
    }
  },
  "$defs": {
    "checkId": {
      "type": "string",
      "enum": [
        "format_lint",
        "commit_message_lint",
        "secret_scan",
        "ticket_spec_validation",
        "changed_module_tests",
        "openapi_validation",
        "integration_tests_touched",
        "coverage_gate_touched",
        "full_test_suite",
        "sast_dependency_scan",
        "migration_safety",
        "performance_smoke",
        "ac_coverage_gate"
      ]
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "required",
        "status",
        "command",
        "exit_code",
        "duration_ms",
        "started_at",
        "finished_at",
        "evidence"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/checkId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "SKIP"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "artifact_paths"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1
            },
            "artifact_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "error": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "FAIL"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "statement",
        "test_ids",
        "negative_test_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[A-Z0-9_-]+-[0-9]+$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TID-[A-Z0-9_-]+$"
          }
        },
        "negative_test_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TID-[A-Z0-9_-]+$"
          }
        }
      }
    },
    "acMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ac_id",
        "test_ids",
        "covered_test_ids",
        "uncovered_test_ids",
        "status"
      ],
      "properties": {
        "ac_id": {
          "type": "string",
          "pattern": "^AC-[A-Z0-9_-]+-[0-9]+$"
        },
        "test_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TID-[A-Z0-9_-]+$"
          }
        },
        "covered_test_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TID-[A-Z0-9_-]+$"
          }
        },
        "uncovered_test_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TID-[A-Z0-9_-]+$"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL"
          ]
        }
      }
    },
    "acCoverageSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_ac",
        "mapped_ac",
        "fully_covered_ac",
        "total_test_ids",
        "covered_test_ids",
        "pass",
        "failures"
      ],
      "properties": {
        "total_ac": {
          "type": "integer",
          "minimum": 0
        },
        "mapped_ac": {
          "type": "integer",
          "minimum": 0
        },
        "fully_covered_ac": {
          "type": "integer",
          "minimum": 0
        },
        "total_test_ids": {
          "type": "integer",
          "minimum": 0
        },
        "covered_test_ids": {
          "type": "integer",
          "minimum": 0
        },
        "pass": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "selfCritique": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_most_likely_to_break",
        "security_or_abuse_path_impacted",
        "proof_test"
      ],
      "properties": {
        "requirement_most_likely_to_break": {
          "type": "string",
          "minLength": 1
        },
        "security_or_abuse_path_impacted": {
          "type": "string",
          "minLength": 1
        },
        "proof_test": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ciParity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_required_check_ids",
        "ci_required_check_ids",
        "matches"
      ],
      "properties": {
        "local_required_check_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/checkId"
          }
        },
        "ci_required_check_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/checkId"
          }
        },
        "matches": {
          "type": "boolean"
        }
      }
    },
    "gitContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "base_ref",
        "head_sha"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_ref": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{7,40}$"
            },
            {
              "type": "string",
              "const": "NO_HEAD"
            }
          ]
        }
      }
    },
    "agentContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "low"
          }
        },
        "required": [
          "risk_level"
        ]
      },
      "then": {
        "properties": {
          "required_check_ids": {
            "const": [
              "format_lint",
              "commit_message_lint",
              "secret_scan",
              "ticket_spec_validation",
              "changed_module_tests",
              "ac_coverage_gate"
            ]
          },
          "checks": {
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "format_lint"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "commit_message_lint"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "secret_scan"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "ticket_spec_validation"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "changed_module_tests"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "ac_coverage_gate"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "medium"
          }
        },
        "required": [
          "risk_level"
        ]
      },
      "then": {
        "properties": {
          "required_check_ids": {
            "const": [
              "format_lint",
              "commit_message_lint",
              "secret_scan",
              "ticket_spec_validation",
              "changed_module_tests",
              "openapi_validation",
              "integration_tests_touched",
              "coverage_gate_touched",
              "ac_coverage_gate"
            ]
          },
          "checks": {
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "format_lint"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "commit_message_lint"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "secret_scan"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "ticket_spec_validation"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "changed_module_tests"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "openapi_validation"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "integration_tests_touched"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "coverage_gate_touched"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "ac_coverage_gate"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "risk_level": {
            "const": "high"
          }
        },
        "required": [
          "risk_level"
        ]
      },
      "then": {
        "properties": {
          "required_check_ids": {
            "const": [
              "format_lint",
              "commit_message_lint",
              "secret_scan",
              "ticket_spec_validation",
              "changed_module_tests",
              "openapi_validation",
              "integration_tests_touched",
              "coverage_gate_touched",
              "full_test_suite",
              "sast_dependency_scan",
              "migration_safety",
              "performance_smoke",
              "ac_coverage_gate"
            ]
          },
          "checks": {
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "format_lint"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "commit_message_lint"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "secret_scan"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "ticket_spec_validation"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "changed_module_tests"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "openapi_validation"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "integration_tests_touched"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "coverage_gate_touched"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "full_test_suite"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "sast_dependency_scan"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "migration_safety"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "performance_smoke"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "ac_coverage_gate"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
