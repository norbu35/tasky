{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasky Self Verify Artifact",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "ticket",
    "risk_level",
    "ticket_spec_path",
    "req_ids",
    "files_changed",
    "required_check_ids",
    "checks",
    "acceptance_criteria",
    "ac_test_mapping",
    "ac_coverage_summary",
    "overall_status",
    "known_risks",
    "assumptions",
    "self_critique",
    "ci_parity",
    "git_context",
    "agent"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "ticket": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "ticket_spec_path": {
      "type": "string"
    },
    "req_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_check_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ac_test_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ac_id": {
            "type": "string"
          },
          "test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "covered_test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uncovered_test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "not_run_test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "not_written_test_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    "ac_coverage_summary": {
      "type": "object",
      "properties": {
        "total_ac": {
          "type": "integer"
        },
        "mapped_ac": {
          "type": "integer"
        },
        "fully_covered_ac": {
          "type": "integer"
        },
        "total_test_ids": {
          "type": "integer"
        },
        "covered_test_ids": {
          "type": "integer"
        },
        "changed_test_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "authorship_check_enabled": {
          "type": "boolean"
        },
        "pass": {
          "type": "boolean"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "known_risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "self_critique": {
      "type": "object"
    },
    "ci_parity": {
      "type": "object"
    },
    "git_context": {
      "type": "object"
    },
    "agent": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
