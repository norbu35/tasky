{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tasky Ticket Spec",
  "type": "object",
  "required": [
    "schema_version",
    "ticket",
    "risk_level",
    "req_ids",
    "depends_on",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "ticket": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "req_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
