{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tasky.local/schemas/ticket.spec.schema.json",
  "title": "Tasky Ticket Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ticket",
    "risk_level",
    "req_ids",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "ticket": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "req_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(REQ|NFR)-[A-Z]+-[0-9]+$"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptanceCriterion"
      }
    }
  },
  "$defs": {
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "statement", "test_ids"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[A-Z0-9_-]+-[0-9]+$"
        },
        "type": {
          "type": "string",
          "enum": ["functional", "security", "abuse", "performance", "reliability", "ui", "data"]
        },
        "statement": {
          "type": "string",
          "minLength": 10
        },
        "test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TID-[A-Z0-9_-]+$"
          }
        },
        "negative_test_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TID-[A-Z0-9_-]+$"
          }
        }
      }
    }
  }
}
