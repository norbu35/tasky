# Production environment configuration.
# Copy to .env on the production host and fill in all values.
# ALL values are REQUIRED in production — no defaults are provided.

SPRING_PROFILES_ACTIVE=prod

# --- Database (owner account for Flyway migrations) ---
POSTGRES_DB=tasky
POSTGRES_USER=tasky
POSTGRES_PASSWORD=

# --- Database (least-privilege runtime account) ---
APP_DB_USER=tasky_app
APP_DB_PASSWORD=

# --- HikariCP pool (tuned for production load) ---
HIKARI_MAX_POOL=20
HIKARI_MIN_IDLE=5

# --- Object Storage (S3/MinIO) ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=tasky-production
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Security secrets ---
# JWT secret: generate with `openssl rand -hex 32`
TASKY_JWT_SECRET=
# Encryption key: generate with `openssl rand -base64 32`
TASKY_ENCRYPTION_KEY=
# Blind index key: generate with `openssl rand -hex 32`
TASKY_BLIND_INDEX_KEY=
# QPay webhook secret: provided by payment gateway
TASKY_QPAY_WEBHOOK_SECRET=

# --- CORS ---
TASKY_CORS_ALLOWED_ORIGINS=https://tasky.mn
TASKY_WEBSOCKET_ALLOWED_ORIGINS=https://tasky.mn

# --- Auth ---
TASKY_DEV_AUTH_ENABLED=false
TASKY_OTP_ENABLED=false
TASKY_ACCESS_TOKEN_TTL_SECONDS=900
TASKY_REFRESH_TOKEN_TTL_SECONDS=1209600

# --- Facebook OAuth ---
TASKY_FACEBOOK_APP_ID=
TASKY_FACEBOOK_APP_SECRET=
TASKY_FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com

# --- Firebase Push ---
TASKY_PUSH_PROVIDER=firebase
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Offsite backup (optional — skip if unset) ---
# OFFSITE_S3_ENDPOINT=https://s3.amazonaws.com
# OFFSITE_S3_BUCKET=tasky-backups
# OFFSITE_S3_ACCESS_KEY=
# OFFSITE_S3_SECRET_KEY=

# --- Feature flags ---
TASKY_FEATURE_MONETIZATION_ENABLED=false

# --- Storage TTLs ---
TASKY_STORAGE_UPLOAD_TTL_SECONDS=900
TASKY_STORAGE_DOWNLOAD_TTL_SECONDS=3600

# --- Web frontend deployment build args (baked into image at build time) ---
# Local web development uses apps/web/.env.local instead of the root .env.
VITE_API_BASE_URL=https://tasky.mn
VITE_DEV_AUTH_ENABLED=false
VITE_FACEBOOK_APP_ID=

# --- Domain (used by Caddy for automatic HTTPS via Let's Encrypt) ---
TASKY_DOMAIN=tasky.mn

# --- Ports ---
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
