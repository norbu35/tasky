# macOS / IDE
.DS_Store
.venv/
.superpowers/
.idea/*
!.idea/codeStyles
# VS Code — track workspace settings, ignore user-specific state
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# Serena (AI agent config — project.yml is intentionally tracked)
.serena/project.local.yml
.serena/cache/
.serena/memories/

# Claude Code local state
.claude/

# Misc local files
.ignore
postflight.json
monorepo-hardening-report.md
.pi/

# Generated audit / analysis snapshots (session artifacts)
docs/DEPENDENCY_VERSION_MATRIX.md
docs/MAINTENANCE_AUDIT_*.md
docs/QUALITY_GATES_AUDIT.md

# Gradle
.gradle/
build/
/bin/
services/api/bin/
*.class

# Python cache
__pycache__/
*.pyc

# Logs
*.log

# Generated codebase snapshots
repomix-output.xml

# JavaScript workspace
node_modules/
apps/*/node_modules/
packages/*/node_modules/
apps/*/dist/
packages/*/dist/
.expo/
apps/*/coverage/
apps/*/playwright-report/
apps/*/test-results/

# Local env overrides
.env

# Web app local env (may contain real Facebook App ID)
apps/web/.env.local

# Generated artifacts (stale session outputs)
baseline.json
postflight-cascade.json
apps/mobile/out.css
repomix-output.*

# Test result dumps (generated, not source)
test-results.json

# Artifacts (keep policy-controlled placeholders)
artifacts/*
!artifacts/.gitkeep
!artifacts/checks/
artifacts/checks/*
!artifacts/checks/.gitkeep

# Scraper output (keep directory placeholder)
research/market-data/unegui/*
!research/market-data/unegui/.gitkeep

# Git worktrees
.worktrees/
