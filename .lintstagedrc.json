{
  "*.{ts,tsx}": [
    "prettier --write",
    "bash -c 'ESLINT_USE_FLAT_CONFIG=false ./apps/web/node_modules/.bin/eslint --no-error-on-unmatched-pattern \"$@\"' --"
  ],
  "*.{json,yaml,yml,md,css}": ["prettier --write"],
  "*.java": ["bash -c 'cd \"$(git rev-parse --show-toplevel)\" && ./gradlew spotlessApply -x test'"]
}
