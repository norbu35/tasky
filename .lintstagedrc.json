{
  "*.{ts,tsx}": ["eslint --fix --no-error-on-unmatched-pattern", "prettier --write"],
  "*.{json,yaml,yml,md,css}": ["prettier --write"],
  "*.java": [
    "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && ./gradlew spotlessApply -x test'",
    "bash -c 'cd \"$(git rev-parse --show-toplevel)\" && ./gradlew checkstyleMain -x test'"
  ]
}
