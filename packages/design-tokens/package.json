{
  "name": "@tasky/design-tokens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/core/primitives.ts",
    "./semantic": "./src/core/semantic.ts",
    "./platform/native": "./src/platform/native.ts",
    "./platform/web": "./src/platform/web.ts",
    "./motion": "./src/core/motion.ts",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "tokens:css": "node scripts/generate-tokens-css.mjs --write",
    "tokens:css:check": "node scripts/generate-tokens-css.mjs --check",
    "build": "pnpm run tokens:css:check && pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"__tests__/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"__tests__/**/*.mjs\"",
    "test": "node scripts/check-package-structure.mjs && pnpm run tokens:css:check && node --test __tests__/*.test.mjs && tsc --noEmit"
  },
  "devDependencies": {
    "@tasky/tooling-config": "workspace:*",
    "eslint": "9.39.2",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2"
  }
}
