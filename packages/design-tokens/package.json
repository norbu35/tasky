{
  "name": "@tasky/design-tokens",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/primitives.ts",
    "./semantic": "./src/semantic.ts",
    "./platform/native": "./src/platform/native.ts",
    "./platform/web": "./src/platform/web.ts",
    "./motion": "./src/motion.ts",
    "./tokens": "./tokens.ts",
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "tsc --noEmit"
  },
  "devDependencies": {
    "@tasky/tooling-config": "workspace:*",
    "eslint": "9.39.2",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
