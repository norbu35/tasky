{
  "name": "@tasky/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "openapi-typescript ../../docs/API.yaml -o src/generated/api-types.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'No SDK lint configured yet.'",
    "test": "echo 'No SDK tests configured yet.'"
  },
  "devDependencies": {
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.2"
  }
}
