{
  "name": "@tasky/sdk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "node ../../tooling/scripts/contracts/bundle-openapi.mjs && openapi-typescript ../../docs/openapi/openapi.yaml -o src/generated/api-types.ts",
    "drift:check": "bash ../../tooling/scripts/contracts/validate-sdk-contract-drift.sh",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'SDK is generated — lint skipped.'",
    "format": "prettier --write \"src/**/*.ts\" --ignore-path ../../.prettierignore",
    "format:check": "prettier --check \"src/**/*.ts\" --ignore-path ../../.prettierignore",
    "test": "tsc --noEmit"
  },
  "devDependencies": {
    "@tasky/tooling-config": "workspace:*",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
