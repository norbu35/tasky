{
  "name": "@tasky/core",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./http": {
      "types": "./src/http/index.ts",
      "default": "./src/http/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test": "vitest run --reporter verbose --passWithNoTests",
    "test:coverage": "vitest run --reporter verbose --coverage --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.100.5",
    "@tasky/sdk": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@tasky/tooling-config": "workspace:*",
    "@tasky/test-utils": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.0.0",
    "eslint": "9.39.2",
    "jsdom": "29.0.2",
    "prettier": "^3.8.3",
    "typescript": "~5.9.2",
    "vitest": "4.1.4",
    "@vitest/coverage-v8": "4.1.4"
  }
}
