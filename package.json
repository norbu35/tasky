{
  "name": "tasky-monorepo",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@react-native/babel-plugin-codegen": "0.83.4",
      "postcss": "8.5.9",
      "minimatch@<3.1.3": ">=3.1.3",
      "tar@<7.5.11": ">=7.5.11",
      "undici@<6.24.0": ">=6.24.0",
      "node-forge@<1.4.0": ">=1.4.0",
      "picomatch@<2.3.2": ">=2.3.2"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "sdk:generate": "pnpm --filter @tasky/sdk generate",
    "sdk:drift": "bash tooling/scripts/validate-sdk-contract-drift.sh",
    "generated:verify": "pnpm sdk:generate && pnpm --filter @tasky/design-tokens build && pnpm -r typecheck",
    "workspace:boundaries": "node tooling/scripts/validate-workspace-boundaries.mjs",
    "pack": "npx repomix",
    "pack:backend": "npx repomix --include 'services/api/**,docs/API.yaml,docs/ARCHITECTURE.md,AGENTS.md,tests/**,tooling/config/**,build.gradle.kts,settings.gradle.kts,gradle.properties' -o repomix-backend.xml",
    "pack:web": "npx repomix --include 'apps/web/**,packages/**,docs/API.yaml,docs/ARCHITECTURE.md,AGENTS.md,tsconfig.json' -o repomix-web.xml",
    "pack:mobile": "npx repomix --include 'apps/mobile/**,packages/**,docs/API.yaml,docs/ARCHITECTURE.md,AGENTS.md' -o repomix-mobile.xml",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tasky/tooling-config": "workspace:*",
    "eslint": "9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1"
  }
}
