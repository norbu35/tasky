{
  "name": "tasky-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@react-native/babel-plugin-codegen": "0.83.4",
      "postcss": "8.5.9",
      "minimatch@<3.1.3": ">=3.1.3",
      "tar@<7.5.11": ">=7.5.11",
      "undici@<6.24.0": ">=6.24.0",
      "node-forge@<1.4.0": ">=1.4.0",
      "picomatch@<2.3.2": ">=2.3.2"
    }
  },
  "scripts": {
    "openapi:bundle": "node tooling/scripts/bundle-openapi.mjs",
    "openapi:check": "node tooling/scripts/bundle-openapi.mjs --check",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "turbo format:check",
    "typecheck": "turbo typecheck",
    "sdk:generate": "turbo sdk:generate",
    "sdk:drift": "bash tooling/scripts/validate-sdk-contract-drift.sh",
    "generated:verify": "pnpm sdk:generate && pnpm --filter @tasky/design-tokens build && pnpm -r typecheck",
    "workspace:boundaries": "node tooling/scripts/validate-workspace-boundaries.mjs",
    "pack": "repomix --split-output 2mb",
    "pack:backend": "repomix --include 'services/api/**,docs/openapi/**,docs/API.yaml,docs/architecture/common.md,services/api/AGENTS.md,AGENTS.md,tests/**,tooling/config/**,build.gradle.kts,settings.gradle.kts,gradle.properties' -o repomix-backend.xml",
    "pack:web": "repomix --include 'apps/web/**,packages/**,docs/openapi/**,docs/API.yaml,docs/architecture/common.md,docs/architecture/web.md,apps/web/AGENTS.md,AGENTS.md,tsconfig.json' -o repomix-web.xml",
    "pack:mobile": "repomix --include 'apps/mobile/**,packages/**,docs/openapi/**,docs/API.yaml,docs/architecture/common.md,docs/architecture/mobile.md,apps/mobile/AGENTS.md,AGENTS.md' -o repomix-mobile.xml",
    "docs:check": "python3 tooling/scripts/check-doc-governance.py && node tooling/scripts/bundle-openapi.mjs --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tasky/tooling-config": "workspace:*",
    "eslint": "9.39.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "repomix": "^1.13.1",
    "turbo": "^2.9.6",
    "yaml": "^2.8.3"
  }
}
