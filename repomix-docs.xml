        type: push
        guard: "tap account tasks"
      - to: SCR-B2B-007
        type: push
        guard: "tap account billing"
      - to: SCR-B2B-004
        type: push
        guard: "tap account members"
      - to: SCR-SHARED-012
        type: pop
        guard: "back"
    data_deps: [business_accounts]

  SCR-B2B-002:
    label: "Business Account Editor"
    edges:
      - to: SCR-B2B-003
        type: push
        guard: "tap manage locations"
      - to: SCR-B2B-004
        type: push
        guard: "tap manage members"
      - to: SCR-B2B-001
        type: pop
        guard: "save success or back"
    data_deps: [account_id, business_account]

  SCR-B2B-003:
    label: "Business Location Editor"
    edges:
      - to: SCR-B2B-002
        type: pop
        guard: "save success or back"
    data_deps: [account_id, location_id, business_location]

  SCR-B2B-004:
    label: "Business Members"
    edges:
      - to: SCR-B2B-002
        type: pop
        guard: "back"
    data_deps: [account_id, members]

  SCR-B2B-005:
    label: "Post Task as Business"
    edges:
      - to: SCR-CUST-002
        type: push
        guard: "business context selected and continue tapped"
      - to: SCR-B2B-006
        type: pop
        guard: "back"
    data_deps: [business_accounts, selected_account, selected_location]

  SCR-B2B-006:
    label: "Business Tasks"
    edges:
      - to: SCR-B2B-005
        type: push
        guard: "tap 'Post Task as Business'"
      - to: SCR-CUST-009
        type: push
        guard: "tap business task card"
      - to: SCR-B2B-001
        type: pop
        guard: "back"
    data_deps: [account_id, business_tasks]

  SCR-B2B-007:
    label: "Business Subscription Billing"
    edges:
      - to: SCR-B2B-001
        type: pop
        guard: "back or billing updated"
    data_deps: [account_id, subscription_plans, current_subscription]

  # ═══════════════════════════════════════════════════
  # PHASE 2 SCREENS
  # ═══════════════════════════════════════════════════

  SCR-P2-001:
    label: "Credits Balance"
    edges:
      - to: SCR-P2-002
        type: push
        guard: "tap 'Buy Credits'"
      - to: SCR-P2-003
        type: push
        guard: "tap 'Transaction History'"
