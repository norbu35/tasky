                liability_disclaimer_accepted:
                  type: boolean
                  description: Must be `true` to initiate payment.
                  enum: [true]
      responses:
        '200':
          description: Payment link generated.
          content:
            application/json:
              schema:
                type: object
                required: [payment_url, qr_code]
                properties:
                  payment_url:
                    type: string
                    format: uri
