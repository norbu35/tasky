    mn: "Гомдол гаргах"
    en: "Submit Appeal"
    max_chars: 20

  - key: cta_appeal_disabled
    mn: "Гомдол илгээгдсэн"
    en: "Appeal Submitted"
    max_chars: 20

  - key: cta_logout
    mn: "Гарах"
    en: "Logout"
    max_chars: 10

