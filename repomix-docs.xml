    components_hidden: [camera_prompt_front, back_upload, selfie_upload, review_section, uploading_indicator]

  - id: back_upload_empty
    description: "Step 2 — ID back photo not yet captured; camera prompt displayed"
    components_visible: [nav_header, step_indicator_step2, camera_prompt_back, instructions_back, back_button, next_button_disabled]
    components_hidden: [front_upload, back_preview, selfie_upload, review_section, uploading_indicator]

  - id: back_upload_captured
    description: "Step 2 — ID back photo captured and previewed; next button enabled"
    components_visible: [nav_header, step_indicator_step2, back_preview, retake_button, back_button, next_button_enabled]
    components_hidden: [camera_prompt_back, front_upload, selfie_upload, review_section, uploading_indicator]

  - id: selfie_upload_empty
    description: "Step 3 — Selfie not yet captured; front-camera prompt with face outline guide"
    components_visible: [nav_header, step_indicator_step3, camera_prompt_selfie, instructions_selfie, back_button, next_button_disabled]
    components_hidden: [front_upload, back_upload, selfie_preview, review_section, uploading_indicator]

