    max_chars: 55

  - key: distance_km
    mn: "{distance} км"
    en: "{distance} km"
    max_chars: 10

  - key: time_ago
    mn: "{time} өмнө"
    en: "{time} ago"
    max_chars: 20

api_endpoints:
  - method: GET
    path: "/tasks"
