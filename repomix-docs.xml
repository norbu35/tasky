          description: Lead response processed.
          content:
            application/json:
              schema:
                oneOf:
                  - type: object
                    required: [booking, accepted, credits_spent, customer_contact_unlocked]
                    properties:
                      booking:
                        $ref: '#/components/schemas/Booking'
                      accepted:
                        type: boolean
                        enum: [true]
                      credits_spent:
                        type: integer
                        example: 1
                      customer_contact_unlocked:
                        type: boolean
                        enum: [true]
                  - type: object
                    required: [booking, accepted, credits_spent, customer_contact_unlocked]
                    properties:
                      booking:
                        $ref: '#/components/schemas/Booking'
                      accepted:
                        type: boolean
                        enum: [false]
                      credits_spent:
                        type: integer
                        enum: [0]
                      customer_contact_unlocked:
                        type: boolean
                        enum: [false]
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: Booking is not eligible for lead unlock or has already been unlocked.
          content:
