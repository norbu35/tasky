      responses:
        '200':
          description: Paginated list of pending payouts.
          content:
            application/json:
              schema:
                type: object
                required: [data, cursor]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/PayoutRequest'
                  cursor:
                    $ref: '#/components/schemas/CursorPagination'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '503':
          description: Monetization feature is disabled for the current rollout phase.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /admin/payouts/{id}/process:
    post:
      tags: [Admin]
      summary: Mark payout as processed
      description: |
        Phase-gated endpoint.
        Admin marks a payout request as processed after completing the bank transfer.
        This debits the tasker's wallet and creates a ledger entry.
        Processing is allowed only on Tuesdays and Fridays in platform timezone.
        Requires Idempotency-Key header.
      operationId: adminProcessPayout
      security:
        - BearerAuth: []
      parameters:
        - $ref: '#/components/parameters/PathId'
        - $ref: '#/components/parameters/IdempotencyKeyHeader'
      responses:
        '200':
          description: Payout processed.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PayoutRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: Payout is not in PENDING status.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'
        '503':
          description: Monetization feature is disabled for the current rollout phase.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /admin/features/toggles:
    get:
      tags: [Admin]
      summary: List feature toggles
      description: Returns monetization and AI feature toggles. Changes are audit-logged.
      operationId: adminListFeatureToggles
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Current feature toggle states.
          content:
            application/json:
              schema:
                type: object
                required: [data]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/FeatureToggle'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

    put:
      tags: [Admin]
      summary: Update feature toggle
      description: Enables or disables runtime feature flags without redeploy.
      operationId: adminUpdateFeatureToggle
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [feature_name, is_enabled]
              properties:
                feature_name:
                  type: string
                  enum:
                    [
                      lead_fee_enabled,
                      subscription_enabled,
                      escrow_enabled,
                      ai_scope_summary_enabled,
                    ]
                  description:
                    Seeded feature toggle names only; presence in this enum does not imply a confirmed
                    runtime consumer in the current launch posture.
                is_enabled:
                  type: boolean
      responses:
        '200':
          description: Feature toggle updated.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/FeatureToggle'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /admin/lead-unlock-prices:
    x-tasky-status: deferred
    x-tasky-target-phase: phase_2
    get:
      tags: [Admin]
      summary: List lead unlock prices
      description: Returns active and scheduled lead-unlock pricing rows by category and district.
      operationId: adminListLeadUnlockPrices
      security:
        - BearerAuth: []
      parameters:
        - $ref: '#/components/parameters/CursorParam'
        - $ref: '#/components/parameters/LimitParam'
      responses:
        '200':
          description: Paginated price rows.
          content:
            application/json:
              schema:
                type: object
                required: [data, cursor]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/LeadUnlockPrice'
                  cursor:
                    $ref: '#/components/schemas/CursorPagination'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

    post:
      tags: [Admin]
      summary: Create or schedule lead unlock price
      operationId: adminCreateLeadUnlockPrice
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [category_id, district_id, credits_required, effective_from]
              properties:
                category_id:
                  type: string
                  format: uuid
                district_id:
                  type: string
                credits_required:
                  type: integer
                  minimum: 1
                effective_from:
                  type: string
                  format: date-time
                effective_to:
                  type: string
                  format: date-time
                  nullable: true
      responses:
        '201':
          description: Price row created.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LeadUnlockPrice'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /admin/categories:
    get:
      tags: [Admin]
      summary: List all categories
      description: Returns paginated categories including inactive ones. Admin only.
      operationId: adminListCategories
      security:
        - BearerAuth: []
      parameters:
        - $ref: '#/components/parameters/CursorParam'
        - $ref: '#/components/parameters/LimitParam'
      responses:
        '200':
          description: Paginated list of all categories.
          content:
            application/json:
              schema:
                type: object
                required: [data, cursor]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Category'
                  cursor:
                    $ref: '#/components/schemas/CursorPagination'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

    post:
      tags: [Admin]
      summary: Create a category
      description: Creates a new service category. Intake can be enabled with schema in separate schema endpoints.
      operationId: adminCreateCategory
      security:
        - BearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [name, name_mn, icon_url, sort_order]
              properties:
                name:
                  type: string
                  minLength: 1
                  example: Cleaning
                name_mn:
                  type: string
                  minLength: 1
                  example: Цэвэрлэгээ
                icon_url:
                  type: string
                  format: uri
                sort_order:
                  type: integer
                intake_enabled:
                  type: boolean
                  default: true
      responses:
        '201':
          description: Category created.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Category'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /admin/categories/{id}:
    put:
      tags: [Admin]
      summary: Update a category
      description: Updates an existing category. Can activate, deactivate, rename, reorder, or toggle intake availability.
      operationId: adminUpdateCategory
      security:
        - BearerAuth: []
      parameters:
        - $ref: '#/components/parameters/PathId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                  minLength: 1
                name_mn:
                  type: string
                  minLength: 1
                icon_url:
                  type: string
                  format: uri
                is_active:
                  type: boolean
                sort_order:
                  type: integer
                intake_enabled:
                  type: boolean
      responses:
        '200':
          description: Category updated.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Category'
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'

  /admin/categories/{id}/schemas:
    get:
      tags: [Admin]
      summary: List category intake schema versions
      operationId: adminListCategorySchemas
      security:
        - BearerAuth: []
      parameters:
        - $ref: '#/components/parameters/PathId'
      responses:
        '200':
          description: Schema versions for category.
          content:
            application/json:
              schema:
                type: object
                required: [data]
                properties:
                  data:
                    type: array
                    items:
                      type: object
                      required: [version, status, schema_json, created_at]
                      properties:
                        version:
                          type: integer
                        status:
                          type: string
                          enum: [DRAFT, CANARY, ACTIVE, ROLLED_BACK]
                        schema_json:
                          type: object
                          additionalProperties: true
                        created_at:
                          type: string
                          format: date-time
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

    post:
      tags: [Admin]
      summary: Create category intake schema version
      description: Runs schema lint/preview checks before persisting version.
      operationId: adminCreateCategorySchema
      security:
        - BearerAuth: []
      parameters:
        - $ref: '#/components/parameters/PathId'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [schema_json]
              properties:
                schema_json:
                  type: object
                  additionalProperties: true
                activate_as:
                  type: string
                  enum: [DRAFT, CANARY, ACTIVE]
      responses:
        '201':
          description: Schema version created.
          content:
            application/json:
              schema:
                type: object
                required: [version, status]
                properties:
                  version:
                    type: integer
                  status:
                    type: string
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /admin/categories/{id}/schemas/{version}/activate:
    post:
      tags: [Admin]
      summary: Activate or rollback category schema version
      operationId: adminActivateCategorySchema
      security:
        - BearerAuth: []
      parameters:
        - $ref: '#/components/parameters/PathId'
        - name: version
          in: path
          required: true
          schema:
            type: integer
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [mode]
              properties:
                mode:
                  type: string
                  enum: [CANARY, ACTIVE, ROLLBACK_TO_LAST_KNOWN_GOOD]
      responses:
        '200':
          description: Schema activation state updated.
          content:
            application/json:
              schema:
                type: object
                properties:
                  version:
                    type: integer
                  status:
                    type: string
        '400':
          $ref: '#/components/responses/BadRequest'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'

  # ─── Security ────────────────────────────────────────────────
  /security/customer/ping:
    get:
      tags: [Security]
      summary: Customer role auth smoke-test
      description: |
        Auth scope smoke-test endpoint. Returns the authenticated user's role
        and userId. Used in integration tests to verify that CUSTOMER
        role-based access control is correctly applied.
      operationId: pingCustomer
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Auth scope confirmed.
          content:
            application/json:
              schema:
                type: object
                required: [role, userId]
                properties:
                  role:
                    type: string
                    example: CUSTOMER
                  userId:
                    type: string
                    format: uuid
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /security/tasker/ping:
    get:
      tags: [Security]
      summary: Tasker role auth smoke-test
      description: |
        Auth scope smoke-test endpoint. Returns the authenticated user's role
        and userId. Used in integration tests to verify that TASKER
        role-based access control is correctly applied.
      operationId: pingTasker
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Auth scope confirmed.
          content:
            application/json:
              schema:
                type: object
                required: [role, userId]
                properties:
                  role:
                    type: string
                    example: TASKER
                  userId:
                    type: string
                    format: uuid
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /security/admin/ping:
    get:
      tags: [Security]
      summary: Admin role auth smoke-test
      description: |
        Auth scope smoke-test endpoint. Returns the authenticated user's role
        and userId. Used in integration tests to verify that ADMIN
        role-based access control is correctly applied.
      operationId: pingAdmin
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Auth scope confirmed.
          content:
            application/json:
              schema:
                type: object
                required: [role, userId]
                properties:
                  role:
                    type: string
                    example: ADMIN
                  userId:
                    type: string
                    format: uuid
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /admin/outbox/summary:
    get:
      tags: [Admin]
      summary: Outbox event summary
      description: Returns counts of outbox events by status (pending, failed, processed, processing).
      operationId: adminOutboxSummary
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Outbox summary.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutboxSummary'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /admin/outbox/events:
    get:
      tags: [Admin]
      summary: List outbox events
      description: Paginated list of outbox events filtered by status.
      operationId: adminListOutboxEvents
      security:
        - BearerAuth: []
      parameters:
        - name: status
          in: query
          required: false
          schema:
            type: string
            enum: [PENDING, FAILED, PROCESSED, PROCESSING]
            default: FAILED
        - name: limit
          in: query
          required: false
          schema:
            type: integer
            default: 50
            minimum: 1
            maximum: 200
        - name: offset
          in: query
          required: false
          schema:
            type: integer
            default: 0
            minimum: 0
      responses:
        '200':
          description: Paginated list of outbox events.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutboxEventPage'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /admin/outbox/events/{id}:
    get:
      tags: [Admin]
      summary: Get outbox event detail
      description: Returns a single outbox event by ID.
      operationId: adminGetOutboxEvent
      security:
        - BearerAuth: []
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
            format: uuid
      responses:
        '200':
          description: Outbox event detail.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OutboxEvent'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'

  /admin/outbox/events/{id}/replay:
    post:
      tags: [Admin]
      summary: Replay outbox event
      description: Resets a FAILED outbox event to PENDING so the processor will retry it.
      operationId: adminReplayOutboxEvent
      security:
        - BearerAuth: []
      parameters:
        - name: id
          in: path
          required: true
          schema:
            type: string
            format: uuid
      responses:
        '200':
          description: Event replay initiated.
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
                  eventId:
                    type: string
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '409':
          description: Event is not in FAILED status.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /admin/outbox/events/replay-all:
    post:
      tags: [Admin]
      summary: Replay all failed outbox events
      description: Resets all FAILED outbox events to PENDING for bulk retry.
      operationId: adminReplayAllOutboxEvents
      security:
        - BearerAuth: []
      responses:
        '200':
          description: Bulk replay initiated.
          content:
            application/json:
              schema:
                type: object
                properties:
                  status:
                    type: string
                  replayed_count:
                    type: integer
                  total_failed:
                    type: integer
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

  /location/reverse-geocode:
    get:
      tags: [Location]
      summary: Reverse geocode coordinates to district-level address
      description: |
        Returns the nearest UB district name and centroid for the provided
        coordinates. Used to populate the location label on the task-post form.
      operationId: reverseGeocode
      security:
        - BearerAuth: []
      parameters:
        - name: lat
          in: query
          required: true
          schema:
            type: number
            format: double
            minimum: -90
            maximum: 90
        - name: lng
          in: query
          required: true
          schema:
            type: number
            format: double
            minimum: -180
            maximum: 180
      responses:
        '200':
          description: District-level address resolved.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/ReverseGeocodeResponse'
        '401':
          $ref: '#/components/responses/Unauthorized'

  /location/search:
    get:
      tags: [Location]
      summary: Search locations by name fragment
      description: |
        Returns matching UB districts for the query string. Used to power the
        address auto-complete on the task-post form.
      operationId: searchLocations
      security:
        - BearerAuth: []
      parameters:
        - name: q
          in: query
          required: true
          schema:
            type: string
            minLength: 1
        - name: bias_lat
          in: query
          required: false
          schema:
            type: number
            format: double
        - name: bias_lng
          in: query
          required: false
          schema:
            type: number
            format: double
      responses:
        '200':
          description: Search results returned (may be empty).
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/LocationSearchResponse'
        '401':
          $ref: '#/components/responses/Unauthorized'
</file>

