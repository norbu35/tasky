# Screen Graph — Tasky Mobile
# Navigation graph: transitions, guards, data dependencies
# Depends on: journey-catalog.yaml, screen-inventory.yaml

# Navigation model: Expo Router file-based routing
# Tab groups: (customer) and (tasker) with role-aware switching
# Transitions: push (detail), replace (auth), modal (sheets), tab (bottom nav)

nodes:

  # ═══════════════════════════════════════════════════
  # SHARED SCREENS
  # ═══════════════════════════════════════════════════

  SCR-SHARED-001:
    label: "Splash"
    edges:
      - to: SCR-SHARED-002
        type: replace
        guard: "no valid JWT"
      - to: SCR-CUST-001
        type: replace
        guard: "valid JWT, role == CUSTOMER"
      - to: SCR-TASK-001
        type: replace
        guard: "valid JWT, role == TASKER"
      - to: SCR-SHARED-004
        type: replace
        guard: "valid JWT, Phase 2, needs OTP migration"
    data_deps: [jwt_token, user_role]

  SCR-SHARED-002:
    label: "Login"
    edges:
      - to: SCR-SHARED-005
        type: replace
        guard: "auth success, new user"
      - to: SCR-CUST-001
        type: replace
        guard: "auth success, returning customer"
      - to: SCR-TASK-001
        type: replace
        guard: "auth success, returning tasker"
      - to: SCR-SHARED-003
        type: push
        guard: "Phase 2+, phone OTP selected"
    data_deps: [facebook_token, phone_number]

  SCR-SHARED-003:
    label: "OTP Verification"
    edges:
      - to: SCR-SHARED-005
        type: replace
        guard: "OTP verified, new user"
      - to: SCR-CUST-001
        type: replace
        guard: "OTP verified, returning customer"
      - to: SCR-TASK-001
        type: replace
        guard: "OTP verified, returning tasker"
    data_deps: [phone_number, otp_code]

  SCR-SHARED-004:
    label: "OTP Migration Gate"
    edges:
      - to: SCR-SHARED-003
        type: push
        guard: "phone entered"
    data_deps: [user_id, phone_number]

  SCR-SHARED-005:
    label: "Onboarding Carousel"
    edges:
      - to: SCR-SHARED-006
        type: replace
        guard: "carousel completed or skipped"
    data_deps: []

  SCR-SHARED-006:
    label: "Role Selection"
    edges:
      - to: SCR-SHARED-007
        type: replace
        guard: "role selected"
    data_deps: [selected_role]

  SCR-SHARED-007:
    label: "Permission — Camera"
    edges:
      - to: SCR-SHARED-008
        type: replace
        guard: "granted or skipped"
    data_deps: []

  SCR-SHARED-008:
    label: "Permission — Location"
    edges:
      - to: SCR-SHARED-009
        type: replace
        guard: "granted or skipped"
    data_deps: []

  SCR-SHARED-009:
    label: "Permission — Notifications"
    edges:
      - to: SCR-CUST-001
        type: replace
        guard: "role == CUSTOMER"
      - to: SCR-TASK-001
        type: replace
        guard: "role == TASKER"
    data_deps: [user_role]

  SCR-SHARED-010:
    label: "Conversation List"
    edges:
      - to: SCR-SHARED-011
        type: push
        guard: "conversation selected"
    data_deps: [user_id]
    tab: inbox

  SCR-SHARED-011:
    label: "Chat Detail"
    edges:
      - to: SCR-SHARED-010
        type: pop
        guard: "back"
      - to: SCR-CUST-013
        type: push
        guard: "tap counterparty avatar, role == customer"
      - to: SCR-CUST-009
        type: push
        guard: "tap task reference"
