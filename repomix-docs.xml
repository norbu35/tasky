    description: "3 photos uploaded; maximum reached; add-photo placeholder hidden"
    components_visible: [COMP-STEPINDICATOR, COMP-PHOTOPICKER, COMP-BUTTON]
    components_hidden: [COMP-TOAST]

  - id: upload_error
    description: "Photo upload failed due to network or server error; error toast with retry"
    components_visible: [COMP-STEPINDICATOR, COMP-PHOTOPICKER, COMP-BUTTON, COMP-TOAST]
    components_hidden: []

copy:
  - key: page_title
    mn: "Зураг оруулах"
    en: "Add Photos"
    max_chars: 20

  - key: step_label
    mn: "Зураг"
    en: "Photos"
    max_chars: 15

  - key: instruction
    mn: "Даалгавартай холбоотой зураг оруулна уу (3 хүртэл)"
    en: "Add photos related to your task (up to 3)"
    max_chars: 60

  - key: helper_optional
    mn: "Зураг оруулах шаардлагагүй — алгасаж болно"
    en: "Photos are optional — you can skip"
    max_chars: 60

  - key: cta_next
    mn: "Үргэлжлүүлэх"
    en: "Continue"
    max_chars: 20

  - key: cta_skip
    mn: "Алгасах"
    en: "Skip"
    max_chars: 10

  - key: cta_back
    mn: "Буцах"
    en: "Back"
    max_chars: 10

  - key: max_reached
    mn: "Хамгийн ихдээ 3 зураг оруулах боломжтой"
    en: "Maximum 3 photos allowed"
    max_chars: 50

  - key: error_upload
    mn: "Зураг оруулахад алдаа гарлаа. Дахин оролдоно уу"
    en: "Photo upload failed. Please try again"
    max_chars: 50

api_endpoints:
  - method: POST
