  SCR-TASK-012:
    label: "My Jobs"
    edges:
      - to: SCR-TASK-013
        type: push
        guard: "tap booking card"
    data_deps: [tasker_bookings]
    tab: my_jobs

  SCR-TASK-013:
    label: "Booking Detail (Tasker)"
    edges:
      - to: SCR-TASK-015
        type: modal
        guard: "tap 'Cancel'"
      - to: SCR-TASK-014
        type: modal
        guard: "no-show flag available"
      - to: SCR-SHARED-010
        type: push
        guard: "tap 'Message'"
      - to: SCR-SHARED-017
        type: push
        guard: "tap 'Leave Review', after completion"
      - to: SCR-TASK-012
        type: pop
        guard: "back"
    data_deps: [booking_id, booking_detail, exact_address]

  SCR-TASK-014:
    label: "No-Show Flag (Tasker)"
    edges:
      - to: SCR-TASK-013
        type: dismiss
        guard: "flagged or dismissed"
    data_deps: [booking_id, schedule_start]

  SCR-TASK-015:
    label: "Booking Cancel (Tasker)"
    edges:
      - to: SCR-TASK-013
        type: dismiss
        guard: "cancel aborted"
      - to: SCR-TASK-012
        type: replace
        guard: "cancellation confirmed"
