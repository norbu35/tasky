# Screen Spec: Applicants List
screen_id: SCR-CUST-011
name: "Applicants List"
route: "/(customer)/tasks/:taskId/applicants"
role: [customer]
phase: "0-1"
template: feed_list
figma_page: "Customer/Applicants List"
feature: "matching"

layout:
  template: feed_list
  density: default
  structure: "safe_area -> nav_header(back + title + applicant_count) -> scrollview(applicant_cards) -> sticky_bottom_cta(accept)"

components:
  - id: COMP-SPLITCARD
    usage: "Applicant cards showing Tasker avatar, name, rating, review count, and verification badge; Phase 2 adds Recommended label"
    props:
      headerContent: "{tasker_avatar, tasker_name, rating, review_count}"
      bodyContent: "{verification_badge, category_match, distance, message_preview}"
      status: "open"
    variant: application

  - id: COMP-PROFILEAVATAR
    usage: "Tasker profile avatar in each applicant card header"
    props:
      imageUrl: "{tasker_avatar}"
      size: "md"
      isVerified: true
    variant: md

  - id: COMP-STARRATING
    usage: "Tasker rating display (read-only) in each applicant card"
    props:
      value: 4.5
      readonly: true
      size: "md"
    variant: display

  - id: COMP-VERIFICATIONBADGE
    usage: "Verified identity badge on each applicant's avatar"
    props:
      isVerified: true
      size: "avatar_badge"
    variant: default

  - id: COMP-BUTTON
    usage: "Accept button per applicant card; Phase 0-1 navigates directly to booking confirmation"
    props:
      label: "Сонгох"
      variant: primary
      size: md
    variant: primary

  - id: COMP-EMPTYSTATE
    usage: "Empty state when no applicants have applied yet"
    props:
      illustration: "applicants_empty"
      headline: "Одоогоор хүсэлт ирээгүй байна"
      description: "Гүйцэтгэгчид хүсэлт илгээх болно. Мэдэгдэл авна"
      ctaLabel: null
    variant: no_results

  - id: COMP-LOADINGSKELETON
    usage: "Card-shaped skeleton placeholders during initial load"
    props:
      variant: card
      count: 3
    variant: card

  - id: COMP-MODALSHEET
    usage: "Accept confirmation sheet before navigating to booking confirmation"
    props:
      visible: false
      title: "Гүйцэтгэгч сонгох"
      primaryAction: "Баталгаажуулах"
      secondaryAction: "Буцах"
    variant: default

states:
  - id: loading_initial
    description: "GET /tasks/:id/applications in progress; skeleton cards shown"
    components_visible: [COMP-LOADINGSKELETON]
    components_hidden: [COMP-SPLITCARD, COMP-EMPTYSTATE, COMP-BUTTON, COMP-MODALSHEET]

  - id: empty
    description: "Zero applicants; empty state with waiting message and notification promise"
    components_visible: [COMP-EMPTYSTATE]
    components_hidden: [COMP-SPLITCARD, COMP-LOADINGSKELETON, COMP-BUTTON, COMP-MODALSHEET]

  - id: populated_phase01
    description: "Phase 0-1: applicants listed in chronological order; each with Accept button"
    components_visible: [COMP-SPLITCARD, COMP-PROFILEAVATAR, COMP-STARRATING, COMP-VERIFICATIONBADGE, COMP-BUTTON]
    components_hidden: [COMP-EMPTYSTATE, COMP-LOADINGSKELETON, COMP-MODALSHEET]

  - id: populated_phase2_ranked
    description: "Phase 2: applicants sorted by relevance score; top-ranked applicants show 'Recommended' label per REQ-BOOK-02"
    components_visible: [COMP-SPLITCARD, COMP-PROFILEAVATAR, COMP-STARRATING, COMP-VERIFICATIONBADGE, COMP-BUTTON]
    components_hidden: [COMP-EMPTYSTATE, COMP-LOADINGSKELETON, COMP-MODALSHEET]

  - id: accept_confirm_sheet
    description: "User tapped Accept on an applicant; confirmation sheet displayed before proceeding"
    components_visible: [COMP-SPLITCARD, COMP-MODALSHEET]
    components_hidden: [COMP-EMPTYSTATE, COMP-LOADINGSKELETON]

  - id: error_network
    description: "GET /tasks/:id/applications failed; error state with retry"
    components_visible: []
    components_hidden: [COMP-SPLITCARD, COMP-EMPTYSTATE, COMP-LOADINGSKELETON, COMP-BUTTON, COMP-MODALSHEET]

copy:
  - key: page_title
    mn: "Хүсэлтүүд"
