        type: push
        guard: "tap 'Submit Review'"
    data_deps: [pending_review_booking_id, lock_reason]
    note: "Blocks all posting/applying until resolved"

  SCR-SHARED-020:
    label: "Suspended Account"
    edges:
      - to: SCR-CUST-001
        type: replace
        guard: "suspension expired"
      - to: SCR-TASK-001
        type: replace
        guard: "suspension expired, role == tasker"
    data_deps: [suspension_expiry, appeal_status]

  SCR-SHARED-021:
    label: "Banned Account"
    edges: []
    data_deps: [ban_reason]
    note: "Terminal screen — no outgoing edges"

  # ═══════════════════════════════════════════════════
  # INFRASTRUCTURE SCREENS
  # ═══════════════════════════════════════════════════

  SCR-INFRA-001:
    label: "Network Error"
    edges:
      - to: "$previous"
        type: replace
        guard: "connectivity restored"
    data_deps: [cached_content]

  SCR-INFRA-002:
    label: "App Update"
    edges:
      - to: "$previous"
        type: dismiss
        guard: "soft update dismissed"
      - to: "$app_store"
