    description: "Task is ASSIGNED and cancellation is <4 hours before schedule; late cancellation warning with reliability incident notice per REQ-BOOK-04"
    components_visible: [COMP-MODALSHEET, COMP-BUTTON]
    components_hidden: []

  - id: confirming
    description: "User confirmed cancellation; API call in progress (DELETE /tasks/:id or PUT /bookings/:id/cancel)"
    components_visible: [COMP-MODALSHEET, COMP-BUTTON]
    components_hidden: []

copy:
  - key: title_open
    mn: "Даалгавар цуцлах уу?"
    en: "Cancel this task?"
