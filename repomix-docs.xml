    en: "Paid out"
    max_chars: 20

  - key: section_transactions
    mn: "Сүүлийн гүйлгээнүүд"
    en: "Recent transactions"
    max_chars: 25

  - key: type_earning
    mn: "Орлого — {taskTitle}"
    en: "Earning — {taskTitle}"
    max_chars: 50

  - key: type_payout
    mn: "Мөнгө татсан"
    en: "Payout"
    max_chars: 20

  - key: status_pending
    mn: "Хүлээгдэж буй"
    en: "Pending"
    max_chars: 15

  - key: status_completed
