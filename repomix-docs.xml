                action:
                  type: string
                  enum: [ACCEPT, DECLINE]
      responses:
        '200':
          description: Reschedule request responded.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BookingScheduleEvent'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
