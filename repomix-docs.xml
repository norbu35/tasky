    components_visible: [nav_header, task_content, customer_info, photos, location, schedule_budget, trust_banner, verify_cta]
    components_hidden: [apply_button, already_applied_badge, cap_reached_notice]

  - id: apply_verified
    description: "Verified tasker can view full detail and apply — primary CTA enabled"
    components_visible: [nav_header, task_content, customer_info, photos, location, schedule_budget, trust_banner, apply_button, message_button]
    components_hidden: [verify_cta, already_applied_badge, cap_reached_notice]

  - id: already_applied
    description: "Tasker has already applied to this task — apply button replaced with status indicator"
    components_visible: [nav_header, task_content, customer_info, photos, location, schedule_budget, trust_banner, already_applied_badge, message_button]
    components_hidden: [apply_button, verify_cta, cap_reached_notice]

  - id: cap_reached
