    variant: horizontal

  - id: COMP-PHOTOPICKER
    usage: "Multi-photo upload grid with add, preview, remove, and progress per photo"
    props:
      photos: []
      maxPhotos: 3
    variant: default

  - id: COMP-BUTTON
