    en: "Approximate location (exact address shown after booking confirmed)"
    max_chars: 80

  - key: description_label
    mn: "Тайлбар"
    en: "Description"
    max_chars: 15

  - key: photos_label
    mn: "Зурагнууд"
    en: "Photos"
    max_chars: 10

  - key: customer_label
    mn: "Захиалагч"
    en: "Customer"
    max_chars: 15

  - key: applicant_count
    mn: "{count} хүн анкет илгээсэн"
