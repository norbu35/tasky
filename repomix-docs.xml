  SCR-TASK-006:
    label: "DAN Fast-Path"
    edges:
      - to: SCR-TASK-008
        type: replace
        guard: "DAN verified"
      - to: SCR-TASK-005
        type: replace
        guard: "DAN failed, fallback to manual"
      - to: SCR-TASK-003
        type: pop
        guard: "back"
    data_deps: [dan_token]

  SCR-TASK-007:
    label: "Verification Pending"
    edges:
      - to: SCR-TASK-008
        type: replace
        guard: "admin approved (push notification)"
      - to: SCR-TASK-009
        type: replace
        guard: "admin rejected (push notification)"
      - to: SCR-TASK-001
        type: pop
        guard: "back"
    data_deps: [verification_status, sla_deadline]

  SCR-TASK-008:
    label: "Verification Approved"
    edges:
      - to: SCR-TASK-001
        type: replace
        guard: "tap 'Start Browsing'"
    data_deps: []

  SCR-TASK-009:
    label: "Verification Rejected"
    edges:
      - to: SCR-TASK-005
        type: push
        guard: "tap 'Resubmit'"
      - to: SCR-TASK-006
        type: push
        guard: "Phase 2, tap 'Try DAN'"
      - to: SCR-TASK-001
        type: pop
        guard: "back"
    data_deps: [rejection_reason]

  SCR-TASK-010:
    label: "Verification Submitted"
    edges:
      - to: SCR-TASK-007
        type: replace
        guard: "tap 'Continue'"
    data_deps: []

  SCR-TASK-011:
    label: "Application Sent"
    edges:
      - to: SCR-TASK-001
        type: replace
        guard: "tap 'Browse More'"
      - to: SCR-TASK-002
        type: dismiss
        guard: "tap 'View Task'"
