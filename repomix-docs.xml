    props:
      visible: true
      title: "Даалгавар цуцлах"
      primaryAction: "Цуцлах"
      secondaryAction: "Буцах"
    variant: default

  - id: COMP-BUTTON
    usage: "Danger-variant cancel button and secondary back/dismiss button"
    props:
      label: "Цуцлах"
      variant: danger
      size: lg
      loading: false
    variant: danger

states:
  - id: open_task_cancel
    description: "Task is OPEN (no booking yet); free cancellation with no penalty warning"
    components_visible: [COMP-MODALSHEET, COMP-BUTTON]
    components_hidden: []

  - id: assigned_cancel_free
    description: "Task is ASSIGNED but cancellation is >4 hours before schedule; free cancellation"
    components_visible: [COMP-MODALSHEET, COMP-BUTTON]
    components_hidden: []

