  SCR-TASK-016:
    label: "Tasker Stats"
    edges:
      - to: SCR-SHARED-012
        type: pop
        guard: "back"
    data_deps: [tasker_stats]

  SCR-TASK-017:
    label: "Lead Unlock"
    edges:
      - to: SCR-TASK-012
        type: dismiss
        guard: "accepted"
      - to: SCR-P2-001
        type: push
        guard: "insufficient credits, tap 'Buy Credits'"
      - to: SCR-TASK-012
        type: dismiss
        guard: "declined or expired"
    data_deps: [application_id, lead_cost, credit_balance]

  SCR-TASK-018:
    label: "Privacy Policy"
    edges:
      - to: "$previous"
        type: pop
        guard: "back"
    data_deps: []

  SCR-TASK-019:
    label: "AI Profile Polish"
    edges:
      - to: SCR-SHARED-013
        type: pop
        guard: "apply success or back"
    data_deps: [user_id, profile_bio, polish_preview]

  # ═══════════════════════════════════════════════════
  # B2B SCREENS
  # ═══════════════════════════════════════════════════

  SCR-B2B-001:
