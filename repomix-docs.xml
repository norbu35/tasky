        outcome: "Prompt to post the first business task"

  - id: JRN-B2B-04
    name: "Business Subscription Billing"
    actor: [customer]
    phase: "3+"
    goal: "View or activate Host Lite / Ops Standard for a business account"
    entry: SCR-B2B-007
    exit: [SCR-B2B-007]
    happy_path:
      - step: 1
        screen: SCR-B2B-007
        action: "View available plans and current status"
        next: SCR-B2B-007
      - step: 2
        screen: SCR-B2B-007
        action: "Activate or renew plan via QPay"
        next: SCR-B2B-007
        lifecycle: "B2B-T02 (business_subscription_activated)"
    alternate_paths:
      - id: JRN-B2B-04-A1
        name: "Renewal failed"
        branch_at: 2
        condition: "Recurring payment renewal fails"
        screens: [SCR-B2B-007]
        outcome: "Show resubscribe path and failed status"

  # ═══════════════════════════════════════════════════
  # INFRASTRUCTURE JOURNEYS
  # ═══════════════════════════════════════════════════

  - id: JRN-INFRA-01
    name: "Error Recovery"
    actor: [customer, tasker]
    phase: "0-1"
    goal: "Recover from network/session errors"
    entry: SCR-INFRA-001
    exit: ["previous screen"]
    paths:
      - name: "Network error"
        screens: [SCR-INFRA-001]
        outcome: "Retry button, show cached content if available"
      - name: "Session expired"
        screens: [SCR-INFRA-003]
        outcome: "Bottom sheet → re-login flow"
      - name: "App update required"
        screens: [SCR-INFRA-002]
        outcome: "Soft: dismissible. Force: blocks until update"

  - id: JRN-INFRA-02
    name: "Suspended/Banned Account"
    actor: [customer, tasker]
    phase: "0-1"
    goal: "Inform user of account restriction"
    entry: SCR-SHARED-020
    exit: [SCR-SHARED-020, SCR-SHARED-021]
    paths:
      - name: "Suspended"
        screens: [SCR-SHARED-020]
        outcome: "Show expiry, appeal option"
        lifecycle: "USER-T05 (strike_threshold_reached)"
        note: "Pending-user suspensions use USER-T06"
      - name: "Banned"
        screens: [SCR-SHARED-021]
        outcome: "No app access"
        lifecycle: "USER-T09 (admin_bans)"
        note: "Suspended/pending-user bans use USER-T10 or USER-T11"

# ─── Summary ────────────────────────────────────────
summary:
  total_journeys: 30
  by_actor:
    shared: 7
    customer: 9
    tasker: 8
    b2b: 4
    infrastructure: 2
  by_phase:
    "0-1": 17
    "2": 9
    "3+": 4
  coverage:
    lifecycle_entities_covered: [task, booking, application, verification, dispute, user, business_account, business_subscription]
    all_screens_reachable: true
    all_terminal_states_reachable: true
</file>

