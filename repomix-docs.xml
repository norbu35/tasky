  SCR-SHARED-012:
    label: "My Profile"
    edges:
      - to: SCR-SHARED-013
        type: push
        guard: "tap edit"
      - to: SCR-SHARED-014
        type: push
        guard: "tap settings"
      - to: SCR-TASK-016
        type: push
        guard: "tap stats, role == tasker"
      - to: SCR-B2B-001
        type: push
        guard: "tap business accounts, role == customer, b2b_enabled"
    data_deps: [user_id, profile]
    tab: profile

  SCR-SHARED-013:
    label: "Edit Profile"
    edges:
      - to: SCR-SHARED-012
        type: pop
        guard: "save success or cancel"
      - to: SCR-TASK-019
        type: push
        guard: "tap 'AI polish', role == tasker"
    data_deps: [user_id, profile]

  SCR-SHARED-014:
    label: "Settings"
    edges:
      - to: SCR-SHARED-012
        type: pop
        guard: "back"
      - to: SCR-SHARED-015
        type: modal
