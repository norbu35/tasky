        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: Booking is not in ASSIGNED status.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /bookings/{id}/reschedule:
    post:
      tags: [Bookings]
      summary: Request booking reschedule
      description: |
        Either booking party may request a reschedule while booking is ASSIGNED.
        Counterparty accepts/declines in-app. Policy timers always reference the latest accepted schedule.
        Requires Idempotency-Key header.
      operationId: requestBookingReschedule
      security:
        - BearerAuth: []
      parameters:
        - $ref: '#/components/parameters/PathId'
        - $ref: '#/components/parameters/IdempotencyKeyHeader'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required: [proposed_scheduled_at]
              properties:
                proposed_scheduled_at:
                  type: string
                  format: date-time
                reason:
                  type: string
                  nullable: true
                  maxLength: 1000
      responses:
        '201':
          description: Reschedule request created.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/BookingScheduleEvent'
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'
        '404':
          $ref: '#/components/responses/NotFound'
        '409':
          description: Booking is not in ASSIGNED status or proposed time invalid.
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/Error'

  /bookings/{id}/reschedule/{eventId}/respond:
    post:
