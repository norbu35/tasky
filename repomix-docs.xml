    en: "Completed"
    max_chars: 15

  - key: cta_payout
    mn: "Мөнгө татах"
    en: "Request payout"
    max_chars: 20

  - key: error_headline
    mn: "Ачааллах боломжгүй"
    en: "Unable to load"
    max_chars: 30

  - key: error_retry
