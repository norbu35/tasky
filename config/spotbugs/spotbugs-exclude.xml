<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0
                            https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!-- Exclude all generated OpenAPI sources — not our code -->
    <Match>
        <Package name="~mn\.tasky\.api\.generated.*"/>
    </Match>

    <!--
        JDBI DAO interfaces are implemented by dynamic proxies at runtime.
        SpotBugs cannot model this and raises false-positive NP warnings on
        every method that returns an object (it sees only the interface).
    -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Or>
            <Class name="~mn\.tasky\..*\.dao\..*Dao"/>
        </Or>
    </Match>

    <!--
        DTO and API records are immutable transfer shapes in this codebase.
        SpotBugs reports EI_EXPOSE_REP* on record accessors that intentionally expose
        already-owned values.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Structured logger placeholders are fixed; this taint path is a known false positive. -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- SpotBugs findings on test fixtures are high-noise and low-value for runtime risk. -->
    <Match>
        <Class name="~mn\.tasky\..*Tests?"/>
    </Match>

</FindBugsFilter>
