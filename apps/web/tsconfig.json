{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "node",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "src",
    "tests",
    "e2e",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
