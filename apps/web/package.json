{
  "name": "@tasky/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\"",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --reporter verbose",
    "test:coverage": "vitest run --reporter verbose --coverage",
    "test:mutation": "stryker run",
    "test:e2e:smoke": "VITE_DEV_AUTH_ENABLED=true pnpm run build && playwright install chromium && playwright test --grep @smoke --project=chromium",
    "test:e2e": "VITE_DEV_AUTH_ENABLED=true pnpm run build && playwright install chromium && playwright test"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.28.0",
    "@tasky/core": "workspace:*",
    "@tasky/design-tokens": "workspace:*",
    "@tasky/sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.2",
    "i18next": "^26.0.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "pigeon-maps": "^0.22.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^17.0.2",
    "react-router-dom": "^7.14.0",
    "sockjs-client": "^1.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "6.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "4.1.4",
    "@tailwindcss/postcss": "^4.2.2",
    "eslint": "9.39.2",
    "jsdom": "29.0.2",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "6.0.2",
    "@tasky/tooling-config": "workspace:*",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  }
}
