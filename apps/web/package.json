{
  "name": "@tasky/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\"",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run --reporter verbose",
    "test:coverage": "vitest run --reporter verbose --coverage",
    "test:mutation": "stryker run",
    "test:e2e:smoke": "VITE_DEV_AUTH_ENABLED=true pnpm run build && playwright install chromium && playwright test --grep @smoke --project=chromium",
    "test:e2e": "VITE_DEV_AUTH_ENABLED=true pnpm run build && playwright install chromium && playwright test"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.28.0",
    "@tasky/core": "workspace:*",
    "@tasky/design-tokens": "workspace:*",
    "@tasky/sdk": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.2",
    "i18next": "^25.8.13",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.575.0",
    "next-themes": "^0.4.6",
    "pigeon-maps": "^0.22.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "^6.1.1",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^6.30.1",
    "sockjs-client": "^1.6.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.13.9",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@types/sockjs-client": "^1.5.4",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "@vitejs/plugin-react": "4.5.0",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@vitest/coverage-v8": "3.0.7",
    "autoprefixer": "^10.4.24",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "jsdom": "26.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.9.2",
    "vite": "5.4.21",
    "vitest": "3.0.7"
  }
}
