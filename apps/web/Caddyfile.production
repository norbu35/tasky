{$TASKY_DOMAIN:localhost} {
    @backend {
        path /api/* /actuator /actuator/* /ws /ws/*
    }
    reverse_proxy @backend {$TASKY_BACKEND_UPSTREAM:app:8080}
    root * /srv
    encode zstd gzip

    header {
        # Security headers
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

        # Content-Security-Policy
        # script-src: 'self' for built bundles; connect.facebook.net for Facebook Login SDK;
        #   hash for the window.global polyfill inline script in index.html.
        # style-src: unsafe-inline required for Tailwind's runtime style injection.
        # connect-src: wss: for WebSocket; graph.facebook.com for FB token exchange.
        Content-Security-Policy "default-src 'self'; script-src 'self' https://connect.facebook.net 'sha256-cYizY3vDbqQt21vuCBaq3by++UJ8kftk0QxU9VQeg9U='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' wss: https://graph.facebook.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
    }

    try_files {path} /index.html
    file_server
}
