{
  "name": "@tasky/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"App.tsx\" \"__tests__/**/*.{ts,tsx}\"",
    "test": "pnpm run test:unit",
    "test:unit": "jest --runInBand",
    "test:e2e:smoke": "bash scripts/run-e2e-smoke.sh",
    "test:e2e": "bash scripts/run-e2e.sh"
  },
  "dependencies": {
    "@tasky/sdk": "workspace:*",
    "expo": "~52.0.39",
    "react": "18.3.1",
    "react-native": "0.76.7"
  },
  "devDependencies": {
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "13.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "18.3.5",
    "eslint": "8.57.1",
    "eslint-config-expo": "8.0.0",
    "jest": "29.7.0",
    "jest-expo": "~52.0.4",
    "react-test-renderer": "18.3.1",
    "typescript": "5.9.2"
  }
}
