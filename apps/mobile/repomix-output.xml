    fontSize: typography.body,
    color: colors.mutedForeground,
    lineHeight: 22,
  },
  warningBox: {
    backgroundColor: colors.muted,
    borderRadius: radius.md,
    padding: spacing.md,
  },
  warningText: {
    fontSize: typography.micro,
    color: colors.mutedForeground,
    lineHeight: 18,
