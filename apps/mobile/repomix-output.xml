<file path="maestro/flows/_support/login-customer.yaml">
appId: mn.tasky.mobile
---
# _support/login-customer.yaml
# Precondition: App is launched and at login screen (SCR-SHARED-002)
# Postcondition: User is logged in as Customer and on customer task list (SCR-CUST-001)
# Uses dev auth bypass (EXPO_PUBLIC_DEV_AUTH_ENABLED=true required)
# Handles the onboarding flow if clearState cleared hasSeenOnboarding

# Dismiss any system "Open in App?" dialog left over from prior deep-link flows
- runFlow:
    when:
      visible: "Cancel"
    commands:
      - tapOn: "Cancel"

# Dismiss any iOS system permission dialog left over from a prior flow
- runFlow:
    when:
      visible: "Allow"
    commands:
      - tapOn: "Allow"
      - waitForAnimationToEnd

- extendedWaitUntil:
    visible:
      id: "SCR-SHARED-002"
    timeout: 30000
- scrollUntilVisible:
    element:
      id: "dev-login-customer"
    direction: DOWN
- tapOn:
    id: "dev-login-customer"

# If onboarding appears (clearState wiped hasSeenOnboarding), go through it as customer
- runFlow:
    when:
      visible:
        id: "SCR-SHARED-005"
    commands:
      - tapOn:
          id: "onboarding-skip"
      - extendedWaitUntil:
          visible:
            id: "SCR-SHARED-006"
          timeout: 10000
      - tapOn:
          id: "role-card-customer"
      - tapOn:
          id: "role-confirm-button"
      - extendedWaitUntil:
          visible:
            id: "role-sheet-confirm"
          timeout: 5000
      - tapOn:
          id: "role-sheet-confirm"
      - waitForAnimationToEnd
      - extendedWaitUntil:
          visible:
            id: "SCR-SHARED-007"
          timeout: 15000
      - tapOn:
          id: "permission-allow-button"
      - runFlow:
          when:
            visible: "Allow"
          commands:
            - tapOn: "Allow"
            - waitForAnimationToEnd
      - waitForAnimationToEnd
      # SCR-SHARED-008 only appears if this permission hasn't been granted yet
      - runFlow:
          when:
            visible:
              id: "SCR-SHARED-008"
          commands:
            - tapOn:
                id: "permission-allow-button"
            - runFlow:
                when:
                  visible: "Allow"
                commands:
                  - tapOn: "Allow"
                  - waitForAnimationToEnd
            - waitForAnimationToEnd
      # SCR-SHARED-009 only appears if this permission hasn't been granted yet
      - runFlow:
          when:
            visible:
              id: "SCR-SHARED-009"
          commands:
            - tapOn:
                id: "permission-allow-button"
            - runFlow:
                when:
                  visible: "Allow"
                commands:
                  - tapOn: "Allow"
                  - waitForAnimationToEnd

- extendedWaitUntil:
    visible:
      id: "SCR-CUST-001"
    timeout: 15000
</file>

