const { colors, spacing } = mobileTheme;

type DisputeStatus =
  | 'OPEN'
  | 'ESCALATED'
  | 'RESOLVED_CUSTOMER'
  | 'RESOLVED_TASKER'
  | 'CLOSED_INSUFFICIENT_EVIDENCE';

type DisputeLike = {
  id: string;
  booking_id: string;
  reason: string;
  status: DisputeStatus | string;
  evidence?: (
    | string
    | { type: string; text_payload?: string | null; storage_key?: string | null }
  )[];
