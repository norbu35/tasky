  } | null;
};

type TimelineState = 'done' | 'current' | 'future';

function buildStatusMeta(
  t: (key: string) => string,
): Record<
  DisputeStatus,
  {
    label: string;
    description: string;
    resolutionText: string;
    badgeStyle: 'warning' | 'success' | 'neutral' | 'danger';
