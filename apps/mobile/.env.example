# Mobile app local environment.
# Copy to apps/mobile/.env for Expo and native builds.
# EXPO_PUBLIC_* values are bundled into the client; do not put secrets here.

EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_DEV_AUTH_ENABLED=true
EXPO_PUBLIC_DEFAULT_LOCALE=mn

# Sentry DSN (leave blank to disable crash reporting locally)
EXPO_PUBLIC_SENTRY_DSN=

# Google Maps SDK keys for native map rendering. Prefer platform-restricted
# keys. If only GOOGLE_MAPS_API_KEY is set, Android and iOS both use it.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
