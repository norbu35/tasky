{
  "extends": ["expo/tsconfig.base", "@tasky/tooling-config/tsconfig/react-native"],
  "compilerOptions": {
    "paths": {
      "@tasky/core": ["../../packages/core/src/index.ts"],
      "@assets/*": ["./assets/*"],
      "@/*": ["./src/*"]
    },
    "types": ["jest", "node"],
    "verbatimModuleSyntax": false
  },
  "include": [
    "nativewind-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx"
  ]
}
