    @SqlQuery("SELECT id, booking_id, raised_by, reason, status, resolution_action, "
            + "wrongful_party_user_id, resolution_notes, created_at, resolved_at "
            + "FROM disputes WHERE status = 'OPEN' ORDER BY id LIMIT :limit")
