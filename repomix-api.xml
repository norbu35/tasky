-- ============================================================
-- Support module
-- ============================================================

CREATE TABLE disputes
(
    id               UUID PRIMARY KEY,
    booking_id UUID NOT NULL REFERENCES bookings (id),
    raiser_id  UUID NOT NULL REFERENCES users (id),
