import org.jdbi.v3.sqlobject.statement.SqlUpdate;

@RegisterConstructorMapper(value = TaskState.class)
public interface TaskDao {

    default void insert(
            String id,
            String customerId,
            String categoryId,
            String description,
            int budget,
            double locationLat,
            double locationLng,
            String locationText,
            String status,
            Instant scheduledAt,
            String intakeAnswersJson,
            Integer intakeSchemaVersion,
            String scopeSummarySource,
            Instant createdAt,
            Instant updatedAt) {
        insert(
                required(id, "id"),
                required(customerId, "customerId"),
                required(categoryId, "categoryId"),
