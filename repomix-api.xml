            @Bind("userId") UUID userId, @Bind("cursor") UUID cursor, @Bind("limit") int limit);

    default boolean existsByBookingIdAndReviewerId(String bookingId, String reviewerId) {
        UUID bookingUuid = required(bookingId, "bookingId");
