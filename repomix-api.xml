CREATE INDEX idx_ledger_entries_user_created_at ON ledger_entries (user_id, created_at DESC);

CREATE TABLE payout_requests
(
    id           UUID PRIMARY KEY,
    user_id UUID NOT NULL REFERENCES users (id),
