            .allowEmptyShould(true);

    @ArchTest
    static final ArchRule domainModulesMustNotDependOnBroker = noClasses()
            .that()
            .resideInAnyPackage(
                    "mn.tasky.auth..",
                    "mn.tasky.booking..",
