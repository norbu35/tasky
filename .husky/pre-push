#!/usr/bin/env bash
set -euo pipefail

echo "Running pre-push checks..."

require_clean_tree() {
  local phase="$1"
  if ! git diff --quiet; then
    if [ "$phase" = "before" ]; then
      echo "pre-push: worktree has unstaged changes. Commit or stash tracked changes before pushing main." >&2
    else
      echo "pre-push: validation changed tracked files in the worktree. Review and commit them before pushing main." >&2
    fi
    exit 1
  fi

  if ! git diff --cached --quiet; then
    if [ "$phase" = "before" ]; then
      echo "pre-push: index has staged changes. Commit or unstage tracked changes before pushing main." >&2
    else
      echo "pre-push: validation changed staged files. Review and commit them before pushing main." >&2
    fi
    exit 1
  fi
}

updates="$(cat)"
pushes_main=0
if [ -n "$updates" ]; then
  while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
      pushes_main=1
      break
    fi
  done <<< "$updates"
fi

if [ "$pushes_main" -eq 0 ]; then
  echo "Non-main push detected — skipping local heavy gates."
  echo "CI quality gates run on merges to 'staging' and 'main'."
  echo "Set RUN_LIGHT_PREPUSH_ON_NON_MAIN=1 to run cleanup+ops on non-main pushes."
  if [ "${RUN_LIGHT_PREPUSH_ON_NON_MAIN:-0}" = "1" ]; then
    pnpm verify:cleanup
    pnpm verify:ops
  fi
  echo "Pre-push checks passed."
  exit 0
fi

echo "Push target includes 'main' — running full local gate."

require_clean_tree "before"
pnpm verify:prepush
require_clean_tree "after"

echo "All pre-push checks passed."
