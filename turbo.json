{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "sdk:generate": {
      "outputs": ["src/generated/**"]
    }
  }
}
