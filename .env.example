# Spring profile: use 'local' for local development, 'prod' for production
SPRING_PROFILES_ACTIVE=local

APP_PORT=8080

POSTGRES_HOST=localhost
POSTGRES_DB=tasky
POSTGRES_USER=tasky
POSTGRES_PASSWORD=tasky
POSTGRES_PORT=5432

# Least-privilege runtime user (created by docker/init-db.sh)
# Used by the Spring Boot app at runtime. Flyway uses POSTGRES_USER/POSTGRES_PASSWORD.
APP_DB_USER=tasky_app
APP_DB_PASSWORD=tasky_app

# PgBouncer
PGBOUNCER_PORT=6432

# HikariCP pool (reduced when PgBouncer handles connection reuse)
HIKARI_MAX_POOL=5
HIKARI_MIN_IDLE=2

# Postgres exporter
POSTGRES_EXPORTER_PORT=9187

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=tasky-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# MinIO S3 client credentials (used by Spring Boot to talk to MinIO)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Security secrets (replace with your own values before running the app)
# JWT secret: 64+ hex chars (example generation: `openssl rand -hex 32`)
TASKY_JWT_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
# Encryption key: base64-encoded 32 random bytes (example: `openssl rand -base64 32`)
TASKY_ENCRYPTION_KEY=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_32
# Blind index key: 64+ chars (example: `openssl rand -hex 32`)
TASKY_BLIND_INDEX_KEY=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
# QPay webhook secret: 64+ chars provided by gateway (or generated for local testing)
TASKY_QPAY_WEBHOOK_SECRET=CHANGE_ME_WITH_QPAY_SECRET

TASKY_CORS_ALLOWED_ORIGINS=http://localhost:5173
TASKY_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:5173

# Web client API base URL (points to the backend; required when web runs on a different port)
VITE_API_BASE_URL=http://localhost:8080

# Local testing helper: enables /api/v1/auth/dev/login endpoint.
# Only supported in local/test profiles and must remain disabled outside local development.
TASKY_DEV_AUTH_ENABLED=true
VITE_DEV_AUTH_ENABLED=true
EXPO_PUBLIC_DEV_AUTH_ENABLED=true

# Facebook OAuth (required for Facebook login; leave blank to disable)
TASKY_FACEBOOK_APP_ID=
TASKY_FACEBOOK_APP_SECRET=
TASKY_FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com

# Firebase (required when TASKY_PUSH_PROVIDER=firebase; full JSON service account key)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Auth / token TTLs
# Enable/disable OTP authentication (default: false)
TASKY_OTP_ENABLED=false
# OTP code time-to-live in seconds (default: 300 = 5 minutes)
TASKY_OTP_TTL_SECONDS=300
# JWT access token TTL in seconds (default: 900 = 15 minutes)
TASKY_ACCESS_TOKEN_TTL_SECONDS=900
# JWT refresh token TTL in seconds (default: 1209600 = 14 days)
TASKY_REFRESH_TOKEN_TTL_SECONDS=1209600

# Storage presigned URL TTLs
# Presigned upload URL TTL in seconds (default: 900 = 15 minutes)
TASKY_STORAGE_UPLOAD_TTL_SECONDS=900
# Presigned download URL TTL in seconds (default: 3600 = 1 hour)
TASKY_STORAGE_DOWNLOAD_TTL_SECONDS=3600

# Feature flags
# Master toggle for monetization features (default: false)
TASKY_FEATURE_MONETIZATION_ENABLED=false
# Push notification provider: logging (dev), firebase (prod)
TASKY_PUSH_PROVIDER=logging
