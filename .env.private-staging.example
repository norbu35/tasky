# Private VPS integration sandbox.
# This is intentionally NOT release-grade staging:
# - runs on SPRING_PROFILES_ACTIVE=local
# - keeps dev auth enabled
# - binds the web/API entrypoint to loopback on the VPS only
# Access it through SSH tunneling, for example:
#   ssh -L 8080:127.0.0.1:8080 <user>@<vps-host>

SPRING_PROFILES_ACTIVE=local
STAGING_HTTP_PORT=8080

POSTGRES_DB=tasky
POSTGRES_USER=tasky
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_OWNER
APP_DB_USER=tasky_app
APP_DB_PASSWORD=CHANGE_ME_APP_RUNTIME

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT
MINIO_BUCKET=tasky-private-staging
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_ROOT

TASKY_JWT_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
TASKY_ENCRYPTION_KEY=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_32
TASKY_BLIND_INDEX_KEY=CHANGE_ME_WITH_OPENSSL_RAND_HEX_32
TASKY_QPAY_WEBHOOK_SECRET=CHANGE_ME_WITH_QPAY_SECRET

TASKY_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
TASKY_WEBSOCKET_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

TASKY_DEV_AUTH_ENABLED=true
VITE_DEV_AUTH_ENABLED=true
EXPO_PUBLIC_DEV_AUTH_ENABLED=true

# For local simulator/device work over the SSH tunnel:
# export EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080

TASKY_FACEBOOK_APP_ID=
TASKY_FACEBOOK_APP_SECRET=
TASKY_FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com

TASKY_OTP_ENABLED=false
TASKY_OTP_TEST_CODE=
TASKY_FEATURE_MONETIZATION_ENABLED=false
TASKY_PUSH_PROVIDER=logging
VITE_API_BASE_URL=
VITE_FACEBOOK_APP_ID=
