<file path=".github/workflows/build-and-push.yml">
name: build-and-push

on:
  push:
    branches: [main]
    tags: ['v*']
  workflow_dispatch:

permissions:
  contents: read
  packages: write

env:
  REGISTRY: ghcr.io
  IMAGE_PREFIX: ${{ github.repository }}

jobs:
  build-backend:
    runs-on: ubuntu-latest
    outputs:
      image-tag: ${{ steps.meta.outputs.version }}
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v4

      - name: Login to GHCR
        uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Docker metadata
        id: meta
        uses: docker/metadata-action@v6
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}/api
          tags: |
            type=ref,event=branch
            type=sha,prefix=
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Build and push backend image
        uses: docker/build-push-action@v7
        with:
          context: .
          file: Dockerfile
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  build-web:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v4

      - name: Login to GHCR
        uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Docker metadata
        id: meta
        uses: docker/metadata-action@v6
        with:
          images: ${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}/web
          tags: |
            type=ref,event=branch
            type=sha,prefix=
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Build and push web image
        uses: docker/build-push-action@v7
        with:
          context: .
          file: apps/web/Dockerfile
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            VITE_API_BASE_URL=${{ vars.VITE_API_BASE_URL }}
            VITE_DEV_AUTH_ENABLED=false
            VITE_FACEBOOK_APP_ID=${{ vars.VITE_FACEBOOK_APP_ID }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

  scan-images:
    needs: [build-backend, build-web]
    runs-on: ubuntu-latest
    strategy:
      matrix:
        image: [api, web]
    steps:
      - name: Login to GHCR
        uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Trivy vulnerability scan
        uses: aquasecurity/trivy-action@0.35.0
        with:
          image-ref: ${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}/${{ matrix.image }}:${{ github.sha }}
          format: table
          ignore-unfixed: true
          vuln-type: os,library
          severity: HIGH,CRITICAL
          exit-code: '1'
</file>

<file path=".github/workflows/deploy-production.yml">
name: deploy-production

on:
  workflow_dispatch:
    inputs:
      image_tag:
        description: 'Image tag to deploy (SHA or semver). Defaults to latest main.'
        required: false
        default: 'latest'
      skip_backup:
        description: 'Skip pre-deploy backup (NOT recommended)'
        required: false
        type: boolean
        default: false

concurrency:
  group: deploy-production
  cancel-in-progress: false

permissions:
  contents: read
  packages: read

env:
  REGISTRY: ghcr.io
  IMAGE_PREFIX: ${{ github.repository }}

jobs:
  # Gate 1: Run the full release-gate checks
  release-gate:
    uses: ./.github/workflows/release-gate.yml
    with:
      target_env: production
    secrets: inherit

  # Gate 2: Verify the image exists and was scanned
  verify-image:
    runs-on: ubuntu-latest
    outputs:
      image-tag: ${{ steps.resolve.outputs.tag }}
    steps:
      - name: Login to GHCR
        uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Resolve image tag
        id: resolve
        run: |
          TAG="${{ github.event.inputs.image_tag }}"
          if [ "$TAG" = "latest" ]; then
            TAG="main"
          fi
          echo "tag=$TAG" >> "$GITHUB_OUTPUT"

          # Verify both images exist
          docker manifest inspect "${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}/api:${TAG}" > /dev/null
          echo "Backend image verified: ${TAG}"

          docker manifest inspect "${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}/web:${TAG}" > /dev/null
          echo "Web image verified: ${TAG}"

  # Gate 3: Manual approval via GitHub environment protection rules
  deploy:
    needs: [release-gate, verify-image]
    runs-on: ubuntu-latest
    environment: production
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Deploy to production
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.PRODUCTION_HOST }}
          username: ${{ secrets.PRODUCTION_USER }}
          key: ${{ secrets.PRODUCTION_SSH_KEY }}
          port: ${{ secrets.PRODUCTION_SSH_PORT || 22 }}
          script: |
            set -euo pipefail
            TAG="${{ needs.verify-image.outputs.image-tag }}"

            cd ${{ secrets.PRODUCTION_DEPLOY_PATH || '~/tasky' }}

            # ---- Pre-deploy backup ----
            SKIP_BACKUP="${{ github.event.inputs.skip_backup }}"
            if [ "$SKIP_BACKUP" != "true" ]; then
              echo "==> Running pre-deploy backup..."
              ./docker/backup.sh
            else
              echo "WARNING: Skipping pre-deploy backup (manual override)"
            fi

            # ---- Capture rollback state ----
            PREV_API_IMAGE=$(docker inspect --format='{{.Config.Image}}' tasky-app 2>/dev/null || echo "none")
            PREV_WEB_IMAGE=$(docker inspect --format='{{.Config.Image}}' tasky-web 2>/dev/null || echo "none")
            echo "Rollback targets: api=${PREV_API_IMAGE} web=${PREV_WEB_IMAGE}" | tee deploy-rollback.txt

            # ---- Pull new images ----
            echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u ${{ github.actor }} --password-stdin

            API_IMAGE="${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}/api:${TAG}"
            WEB_IMAGE="${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}/web:${TAG}"

            docker pull "$API_IMAGE"
            docker pull "$WEB_IMAGE"

            # Tag for compose
            docker tag "$API_IMAGE" tasky-server:production
            docker tag "$WEB_IMAGE" tasky-web:production

            # ---- Deploy ----
            docker compose -f docker-compose.production.yml up -d --no-build --remove-orphans

            # ---- Health verification ----
            echo "Waiting for backend health..."
            HEALTHY=false
            for i in $(seq 1 30); do
              if curl -sf http://localhost:8080/actuator/health/liveness > /dev/null 2>&1; then
                echo "Backend healthy after ${i}0s"
                HEALTHY=true
                break
              fi
              sleep 10
            done

            if [ "$HEALTHY" != "true" ]; then
              echo "ERROR: Backend failed health check — initiating rollback"
              if [ "$PREV_API_IMAGE" != "none" ]; then
                docker tag "$PREV_API_IMAGE" tasky-server:production
                docker tag "$PREV_WEB_IMAGE" tasky-web:production
                docker compose -f docker-compose.production.yml up -d --no-build
                echo "Rollback completed"
              fi
              exit 1
            fi

  post-deploy-smoke:
    needs: deploy
    runs-on: ubuntu-latest
    steps:
      - name: Production smoke tests
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.PRODUCTION_HOST }}
          username: ${{ secrets.PRODUCTION_USER }}
          key: ${{ secrets.PRODUCTION_SSH_KEY }}
          port: ${{ secrets.PRODUCTION_SSH_PORT || 22 }}
          script: |
            set -euo pipefail

            echo "=== Production Smoke Tests ==="

            # Health + readiness
            curl -sf http://localhost:8080/actuator/health | jq .status
            curl -sf http://localhost:8080/actuator/health/readiness | jq .status

            # API version
            curl -sf http://localhost:8080/api/v1/system/version | jq .

            # Verify dev-auth is DISABLED
            DEV_AUTH_STATUS=$(curl -so /dev/null -w '%{http_code}' -X POST http://localhost:8080/api/v1/auth/dev/login 2>/dev/null || echo "000")
            if [ "$DEV_AUTH_STATUS" = "404" ] || [ "$DEV_AUTH_STATUS" = "403" ]; then
              echo "Dev-auth correctly disabled: $DEV_AUTH_STATUS"
            else
              echo "CRITICAL: Dev-auth may be enabled! Status: $DEV_AUTH_STATUS"
              exit 1
            fi

            # Prometheus metrics available
            curl -sf http://localhost:8080/actuator/prometheus > /dev/null
            echo "Prometheus: OK"

            # Web frontend
            HTTP_STATUS=$(curl -so /dev/null -w '%{http_code}' http://localhost:80/ 2>/dev/null || echo "000")
            if [ "$HTTP_STATUS" = "200" ] || [ "$HTTP_STATUS" = "304" ]; then
              echo "Web frontend: OK"
            else
              echo "WARNING: Web frontend returned $HTTP_STATUS"
            fi

            echo "=== All production smoke tests passed ==="
            echo "Deploy timestamp: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
</file>

<file path=".github/workflows/deploy-staging.yml">
name: deploy-staging

on:
  workflow_run:
    workflows: [build-and-push]
    types: [completed]
    branches: [main]
  workflow_dispatch:

concurrency:
  group: deploy-staging
  cancel-in-progress: false

permissions:
  contents: read
  packages: read

env:
  REGISTRY: ghcr.io
  IMAGE_PREFIX: ${{ github.repository }}

jobs:
  pre-deploy-checks:
    runs-on: ubuntu-latest
    if: ${{ github.event_name == 'workflow_dispatch' || github.event.workflow_run.conclusion == 'success' }}
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Ensure scripts are executable
        run: chmod +x tooling/scripts/*.sh tooling/scripts/*.py

      - name: Validate migration safety
        run: python3 tooling/scripts/validate-migrations.py

  deploy:
    needs: pre-deploy-checks
    runs-on: ubuntu-latest
    environment: staging
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Determine image tag
        id: tag
        run: echo "sha=$(git rev-parse --short HEAD)" >> "$GITHUB_OUTPUT"

      - name: Deploy to staging VPS
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.STAGING_HOST }}
          username: ${{ secrets.STAGING_USER }}
          key: ${{ secrets.STAGING_SSH_KEY }}
          port: ${{ secrets.STAGING_SSH_PORT || 22 }}
          script: |
            set -euo pipefail

            cd ${{ secrets.STAGING_DEPLOY_PATH || '~/tasky' }}

            # Pull latest compose and config from the repo
            git fetch origin main
            git reset --hard origin/main

            # Login to GHCR
            echo "${{ secrets.GITHUB_TOKEN }}" | docker login ghcr.io -u ${{ github.actor }} --password-stdin

            # Export image references for compose
            export TASKY_API_IMAGE="${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}/api:${{ steps.tag.outputs.sha }}"
            export TASKY_WEB_IMAGE="${{ env.REGISTRY }}/${{ env.IMAGE_PREFIX }}/web:${{ steps.tag.outputs.sha }}"

            # Pre-deploy backup
            ./docker/backup.sh || echo "WARNING: backup failed (may be first deploy)"

            # Pull new images
            docker pull "$TASKY_API_IMAGE"
            docker pull "$TASKY_WEB_IMAGE"

            # Tag for compose
            docker tag "$TASKY_API_IMAGE" tasky-server:private-staging
            docker tag "$TASKY_WEB_IMAGE" tasky-web:private-staging

            # Rolling restart: infra stays up, app containers restart
            docker compose -f docker-compose.private-staging.yml up -d --no-build --remove-orphans

            # Wait for backend health
            echo "Waiting for backend health..."
            for i in $(seq 1 30); do
              if curl -sf http://localhost:8080/actuator/health/liveness > /dev/null 2>&1; then
                echo "Backend healthy after ${i}0s"
                break
              fi
              if [ "$i" -eq 30 ]; then
                echo "ERROR: Backend failed to become healthy"
                docker compose -f docker-compose.private-staging.yml logs app --tail=50
                exit 1
              fi
              sleep 10
            done

  smoke-test:
    needs: deploy
    runs-on: ubuntu-latest
    steps:
      - name: Smoke test staging endpoints
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.STAGING_HOST }}
          username: ${{ secrets.STAGING_USER }}
          key: ${{ secrets.STAGING_SSH_KEY }}
          port: ${{ secrets.STAGING_SSH_PORT || 22 }}
          script: |
            set -euo pipefail

            echo "=== Staging Smoke Tests ==="

            # Health check
            curl -sf http://localhost:8080/actuator/health | jq .status
            echo "Health: OK"

            # Readiness check
            curl -sf http://localhost:8080/actuator/health/readiness | jq .status
            echo "Readiness: OK"

            # API version endpoint
            curl -sf http://localhost:8080/api/v1/system/version | jq .
            echo "Version: OK"

            # Web frontend serves HTML
            HTTP_STATUS=$(curl -so /dev/null -w '%{http_code}' http://localhost:80/ 2>/dev/null || echo "000")
            if [ "$HTTP_STATUS" = "200" ] || [ "$HTTP_STATUS" = "304" ]; then
              echo "Web frontend: OK ($HTTP_STATUS)"
            else
              echo "WARNING: Web frontend returned $HTTP_STATUS"
            fi

            echo "=== All smoke tests passed ==="
</file>

<file path=".github/workflows/nightly-mobile.yml">
name: nightly-mobile-e2e

on:
  schedule:
    - cron: '0 2 * * 1,4'
  workflow_dispatch:

jobs:
  e2e-ios:
    runs-on: macos-latest
    permissions:
      contents: read
    env:
      CI: '1'
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Setup Java 21
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '21'

      - name: Setup Node.js 20
        uses: actions/setup-node@v6
        with:
          node-version: '22'

      - name: Setup pnpm
        uses: pnpm/action-setup@v6

      - name: Setup Gradle cache
        uses: gradle/actions/setup-gradle@v6

      - name: Ensure scripts are executable
        run: chmod +x gradlew

      - name: Install workspace dependencies
        run: pnpm install --frozen-lockfile

      - name: Start infrastructure
        run: |
          docker compose up -d postgres minio minio-bootstrap
          for i in $(seq 1 30); do
            docker compose exec -T postgres pg_isready -U tasky -d tasky && break
            sleep 2
          done

      - name: Build and start backend
        run: |
          ./gradlew --no-daemon :services:api:bootJar
          java -jar services/api/build/libs/*.jar --spring.profiles.active=ci &
          for i in $(seq 1 30); do
            curl -sf http://localhost:8080/actuator/health && break
            sleep 2
          done
        env:
          FACEBOOK_TEST_APP_ID: ${{ secrets.FACEBOOK_TEST_APP_ID }}
          FACEBOOK_TEST_APP_SECRET: ${{ secrets.FACEBOOK_TEST_APP_SECRET }}
          TASKY_JWT_SECRET: ${{ secrets.CI_JWT_SECRET }}
          TASKY_ENCRYPTION_KEY: ${{ secrets.CI_ENCRYPTION_KEY }}
          TASKY_BLIND_INDEX_KEY: ${{ secrets.CI_BLIND_INDEX_KEY }}
          TASKY_QPAY_WEBHOOK_SECRET: ${{ secrets.CI_QPAY_WEBHOOK_SECRET }}

      - name: Install Maestro CLI
        run: |
          curl -Ls "https://get.maestro.mobile.dev" | bash
          echo "$HOME/.maestro/bin" >> "$GITHUB_PATH"

      - name: Boot iOS simulator
        run: |
          SIMULATOR_NAME="$(xcrun simctl list devices available | awk -F '[()]' '/iPhone/ {gsub(/^ +| +$/, "", $1); print $1; exit}')"
          SIMULATOR_UDID="$(xcrun simctl list devices available | awk -F '[()]' '/iPhone/ {print $2; exit}')"
          if [ -z "$SIMULATOR_NAME" ] || [ -z "$SIMULATOR_UDID" ]; then
            echo "ERROR: no available iPhone simulator found" >&2
            exit 1
          fi
          echo "SIMULATOR_NAME=$SIMULATOR_NAME" >> "$GITHUB_ENV"
          echo "SIMULATOR_UDID=$SIMULATOR_UDID" >> "$GITHUB_ENV"
          open -a Simulator
          xcrun simctl boot "$SIMULATOR_UDID" || true
          xcrun simctl bootstatus "$SIMULATOR_UDID" -b

      - name: Build iOS release app
        run: pnpm --filter @tasky/mobile exec expo run:ios --configuration Release --device "$SIMULATOR_NAME" --no-bundler

      - name: Run Maestro smoke flows
        run: pnpm --filter @tasky/mobile test:e2e:smoke

      - name: Stop infrastructure
        if: always()
        run: docker compose down
</file>

