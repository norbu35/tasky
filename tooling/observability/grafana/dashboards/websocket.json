{
  "uid": "tasky-websocket",
  "title": "Tasky WebSocket",
  "description": "WebSocket/STOMP connection and messaging metrics — upgrade rate, message throughput, and errors.",
  "tags": ["tasky"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Connections",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "WS Upgrade Request Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{uri=~\"/ws.*\"}[5m])",
          "refId": "A",
          "legendFormat": "{{ method }} {{ uri }} {{ status }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 }
    },
    {
      "id": 3,
      "title": "Active WebSocket Connections",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "spring_rabbitmq_listener_active{queue=~\"amq.*\"}",
          "refId": "A",
          "legendFormat": "{{ queue }}"
        }
      ],
      "description": "RabbitMQ listener count as a proxy for active STOMP subscriptions. Falls back to 0 if spring_rabbitmq_listener metrics are not exported.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "value": null, "color": "green" }]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 }
    },
    {
      "id": 10,
      "title": "Message Throughput",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }
    },
    {
      "id": 11,
      "title": "Message Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(spring_rabbitmq_listener_received_total[5m])",
          "refId": "A",
          "legendFormat": "received ({{ queue }})"
        },
        {
          "expr": "rate(spring_rabbitmq_listener_published_total[5m])",
          "refId": "B",
          "legendFormat": "published"
        }
      ],
      "description": "RabbitMQ message throughput for STOMP-relayed channels.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 }
    },
    {
      "id": 12,
      "title": "WS Upgrade Duration P95",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/ws.*\"}[5m])) by (le, uri))",
          "refId": "A",
          "legendFormat": "{{ uri }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 }
    },
    {
      "id": 20,
      "title": "Errors",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 }
    },
    {
      "id": 21,
      "title": "WebSocket Errors",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{uri=~\"/ws.*\",status!~\"1..|2..|3..\"}[5m])",
          "refId": "A",
          "legendFormat": "{{ status }} {{ uri }}"
        },
        {
          "expr": "rate(spring_rabbitmq_listener_errors_total[5m])",
          "refId": "B",
          "legendFormat": "rabbitmq errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10 },
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 }
    },
    {
      "id": 22,
      "title": "Failed Upgrades",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{uri=~\"/ws.*\",status=~\"4..|5..\"}[5m]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 0.01, "color": "yellow" },
              { "value": 0.1, "color": "red" }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 }
    }
  ]
}
