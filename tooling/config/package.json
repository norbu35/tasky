{
  "name": "@tasky/tooling-config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run lint",
    "typecheck": "pnpm run lint",
    "lint": "find . -type f -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "format": "prettier --write \"**/*.{json,yaml,yml,xml,mjs,ts}\"",
    "format:check": "prettier --check \"**/*.{json,yaml,yml,xml,mjs,ts}\"",
    "test": "pnpm run lint"
  },
  "exports": {
    "./tsconfig/base": "./tsconfig/base.json",
    "./tsconfig/strict": "./tsconfig/strict.json",
    "./tsconfig/react": "./tsconfig/react.json",
    "./tsconfig/react-native": "./tsconfig/react-native.json",
    "./eslint/base": {
      "types": "./eslint/base.d.ts",
      "default": "./eslint/base.mjs"
    },
    "./eslint/react": {
      "types": "./eslint/react.d.ts",
      "default": "./eslint/react.mjs"
    },
    "./eslint/react-native": {
      "types": "./eslint/react-native.d.ts",
      "default": "./eslint/react-native.mjs"
    },
    "./vitest/base": {
      "types": "./vitest/base.d.ts",
      "default": "./vitest/base.mjs"
    },
    "./prettier": {
      "types": "./prettier/index.d.ts",
      "default": "./prettier/index.mjs"
    }
  },
  "dependencies": {
    "@eslint/js": "^9.39.0",
    "@tanstack/eslint-plugin-query": "^5.100.9",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "^3.10.0",
    "eslint-plugin-import-x": "^4.6.0",
    "eslint-plugin-no-secrets": "^1.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-security": "^3.0.0",
    "eslint-plugin-unused-imports": "^4.1.0",
    "globals": "^16.0.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.0.0"
  }
}
