<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0
                            https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!--
        Exclusion policy follows SpotBugs' own guidance:
        https://github.com/spotbugs/spotbugs/blob/4.8.6/spotbugs/findbugsExclude.xml

        SpotBugs' upstream project globally excludes EI_EXPOSE_REP, EI_EXPOSE_REP2,
        and the entire MALICIOUS_CODE category as too noisy for real-world projects.
        We follow the same approach, scoped to our Spring-managed service layer.

        For individual false positives on specific classes, prefer @SuppressFBWarnings
        with a justification, as documented in:
        https://spotbugs.readthedocs.io/en/stable/annotations.html
    -->

    <!-- Exclude all generated OpenAPI sources — not our code -->
    <Match>
        <Package name="~mn\.tasky\.api\.generated.*"/>
    </Match>

    <!--
        EI_EXPOSE_REP2 / EI_EXPOSE_REP: Globally excluded by SpotBugs upstream.
        In a Spring Boot application, constructor injection stores DAOs, ObjectMapper,
        MeterRegistry etc. in private final fields. SpotBugs cannot model Spring's
        singleton container lifecycle and flags every constructor assignment as
        "internal representation exposure by incorporating reference to mutable object".
        These are false positives for dependency-injected beans.
        See: https://github.com/spotbugs/spotbugs/blob/4.8.6/spotbugs/findbugsExclude.xml
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!--
        JDBI DAO interfaces are implemented by dynamic proxies at runtime.
        SpotBugs cannot model this and raises false-positive NP warnings on
        every method that returns an object (it sees only the interface).
    -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Or>
            <Class name="~mn\.tasky\..*\.dao\..*Dao"/>
        </Or>
    </Match>

    <!-- Structured logger placeholders are fixed; this taint path is a known false positive. -->
    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!--
        NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE in service and composition layers.
        These classes work with record types whose accessors (budget(), confirmedScheduledAt(),
        intakeSchemaVersion(), etc.) are nullable by design. SpotBugs cannot follow the ternary
        null guards and short-circuit patterns used at each call site. Use @SuppressFBWarnings
        on individual methods when the warning reveals a real missing null check.
    -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
        <Or>
            <Package name="~mn\.tasky\.runtime\.publicapi\.composition"/>
            <Package name="~mn\.tasky\.runtime\.adminapi\.composition"/>
            <Package name="~mn\.tasky\.booking\.application"/>
            <Package name="~mn\.tasky\.task\.application"/>
            <Package name="~mn\.tasky\.task\.api"/>
            <Package name="~mn\.tasky\.category\.api"/>
        </Or>
    </Match>

    <!-- SpotBugs findings on test fixtures and support classes are high-noise and low-value for runtime risk. -->
    <Match>
        <Or>
            <Class name="~mn\.tasky\..*Test[s]?(\$.*)?"/>
            <Class name="~mn\.tasky\..*TestSupport.*"/>
        </Or>
    </Match>

</FindBugsFilter>
