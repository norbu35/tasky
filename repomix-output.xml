    mn: "Одоогийн тайлбар"
    en: "Current description"
    max_chars: 24

  - key: polished_label
    mn: "Санал болгосон хувилбар"
    en: "Suggested version"
    max_chars: 28

  - key: tone_label
    mn: "Хэв маяг"
    en: "Tone"
    max_chars: 12

  - key: cta_generate
    mn: "Санал болгох"
    en: "Generate suggestion"
    max_chars: 22

  - key: cta_apply
    mn: "Энэ хувилбарыг хэрэглэх"
    en: "Apply this version"
    max_chars: 28

  - key: toast_success
    mn: "Санал болгосон текст хадгалагдлаа"
