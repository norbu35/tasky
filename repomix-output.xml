  - key: section_task_summary
    mn: Даалгаврын товч
    en: Task Summary
  - key: section_schedule
    mn: Товлосон цаг
    en: Scheduled Time
  - key: section_location
    mn: Байршил
    en: Location
  - key: section_budget
    mn: Төсөв
    en: Budget
  - key: section_timeline
    mn: Түүх
    en: Timeline
  - key: cta_message
    mn: Зурвас илгээх
    en: Message
  - key: cta_confirm_complete
    mn: Дуусгасныг баталгаажуулах
    en: Confirm Complete
