      responses:
        '200':
          description: Configured service areas.
          content:
            application/json:
              schema:
                type: object
                required: [ data ]
                properties:
                  data:
                    type: array
                    items:
                      type: object
                      required: [ id, name, name_mn, slug ]
                      properties:
                        id:
                          type: string
                        name:
                          type: string
                        name_mn:
                          type: string
                        slug:
                          type: string
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

    put:
      tags: [ Users ]
      summary: Replace my tasker service areas
      description: Replaces the authenticated tasker's district coverage by district slug.
      operationId: setTaskerServiceAreas
      security:
        - BearerAuth: [ ]
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                district_slugs:
                  type: array
                  items:
                    type: string
      responses:
        '204':
          description: Service areas updated.
        '401':
          $ref: '#/components/responses/Unauthorized'
        '403':
          $ref: '#/components/responses/Forbidden'

