    [JRN-INFRA-02]="JRN-INFRA-02-suspended-banned-account.yaml"
  )

  declare -A P1_FLOWS=(
    [JRN-SHARED-04]="JRN-SHARED-04-messaging.yaml"
    [JRN-SHARED-05]="JRN-SHARED-05-profile-management.yaml"
