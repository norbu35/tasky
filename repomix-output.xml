layout:
  template: auth
  density: comfortable
  structure: "safe_area -> nav_header(back) -> centered_content(heading + description + otp_input + resend_link) -> bottom_cta(verify_button)"

components:
  - id: COMP-INPUT
    usage: "OTP code entry field; 4-digit numeric input with auto-advance"
    props:
      placeholder: "- - - -"
      label: "Баталгаажуулах код"
      maxLength: 4
    variant: default

  - id: COMP-FORMFIELD
    usage: "Wraps OTP input with label, error, and helper text"
    props:
      label: "Баталгаажуулах код"
      required: true
      helperText: "Таны утсанд илгээсэн 4 оронтой код"
    variant: default

  - id: COMP-BUTTON
    usage: "Primary verify CTA at screen bottom"
    props:
      label: "Баталгаажуулах"
      variant: primary
      size: xl
      loading: false
    variant: primary

  - id: COMP-BUTTON
    usage: "Resend code link styled as ghost button with countdown timer"
    props:
      label: "Код дахин илгээх"
      variant: ghost
      size: md
      disabled: true
    variant: ghost

states:
  - id: default
    description: "OTP screen loaded; phone number displayed; input field empty and focused"
    components_visible: [heading, phone_display, otp_input, verify_button_disabled, resend_link]
    components_hidden: [error_message, verifying_spinner]

  - id: code_entry
    description: "User is entering the OTP code digits"
    components_visible: [heading, phone_display, otp_input_active, verify_button_enabled, resend_link]
    components_hidden: [error_message, verifying_spinner]

  - id: verifying
    description: "OTP code submitted; verification request in progress"
    components_visible: [heading, phone_display, otp_input_disabled, verify_button_loading]
    components_hidden: [error_message, resend_link]

  - id: error_wrong_code
    description: "User entered incorrect OTP code; field shows error and clears"
    components_visible: [heading, phone_display, otp_input_error, wrong_code_error, verify_button_disabled, resend_link]
    components_hidden: [verifying_spinner]

  - id: error_expired
    description: "OTP code has expired; user must request a new code"
    components_visible: [heading, phone_display, otp_input_disabled, expired_error, resend_link_enabled]
    components_hidden: [verify_button, verifying_spinner]

  - id: resend_cooldown
    description: "Resend requested; countdown timer shown (60s) before resend is available again"
    components_visible: [heading, phone_display, otp_input, verify_button, resend_countdown]
    components_hidden: [error_message, resend_link_enabled]

  - id: error_network
    description: "Network error during OTP verification or resend request"
    components_visible: [heading, phone_display, otp_input, network_error_message, verify_button, resend_link]
    components_hidden: [verifying_spinner]

copy:
