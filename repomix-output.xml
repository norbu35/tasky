  - name: Verification
    description: Tasker identity verification
  - name: Categories
    description: Service categories
  - name: Tasks
    description: Task posting and discovery
  - name: Applications
    description: Tasker applications to tasks
  - name: Bookings
    description: Booking lifecycle
  - name: Payments
    description: QPay payment integration (feature-toggled by phase)
  - name: Credits
    description: Phase 2 lead-unlock credit ledger and purchases
  - name: Wallet
    description: Tasker wallet and payouts (feature-toggled by phase)
  - name: Reviews
    description: Post-completion reviews
