    props:
      value: 0
      onChange: "handleQualityRating"
      readonly: false
      size: lg
    variant: input

  - id: COMP-STARRATING
    usage: "Interactive star rating input for punctuality dimension"
    props:
      value: 0
      onChange: "handlePunctualityRating"
