    mn: Дахин захиалах
    en: Rebook
  - key: cta_reschedule
    mn: Цаг өөрчлөх
    en: Reschedule
  - key: cta_cancel
    mn: Захиалга цуцлах
    en: Cancel Booking
  - key: cta_report_issue
    mn: Асуудал мэдэгдэх
    en: Report Issue
  - key: cta_timeline
    mn: Түүх харах
    en: View Timeline
  - key: cta_leave_review
    mn: Үнэлгээ өгөх
    en: Leave Review
  - key: cta_pay_escrow
    mn: Эскроу төлбөр хийх
    en: Pay with Escrow
  - key: status_assigned
    mn: Баталгаажсан
    en: Assigned
  - key: status_tasker_marked_done
    mn: Дууссан гэж тэмдэглэсэн
    en: Marked as done
  - key: status_completed
    mn: Дууссан
    en: Completed
  - key: status_cancelled
    mn: Цуцалсан
    en: Cancelled
  - key: status_no_show
    mn: Ирээгүй
    en: No-Show
  - key: payment_note
    mn: Төлбөрийг гүйцэтгэгчтэй шууд тохиролцоно
    en: Payment is settled directly with the Tasker
  - key: approaching_warning
    mn: Товлосон цаг хүртэл 4 цагаас бага хугацаа үлдлээ
    en: Less than 4 hours until scheduled time
  - key: escrow_pending_label
    mn: Эскроу төлбөр хүлээгдэж байна
    en: Escrow payment pending
  - key: escrow_held_label
    mn: Эскроу барьцаа хадгалагдаж байна
