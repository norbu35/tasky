        : 'auth.roleSelection.taskerDescription';

    return (
      <Pressable
        key={role}
        testID={`role-card-${role}`}
        onPress={() => setSelectedRole(role)}
        className={cn('rounded-xl overflow-hidden', isSelected && 'border-2')}
