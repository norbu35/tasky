                    {t(`admin.disputes.status_${dispute.status}`, dispute.status)}
                  </Badge>
                </td>
                <td className="px-4 py-3">{formatDate(dispute.created_at)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
