                "budget", 50000,
                "location_lat", 47.9, "location_lng", 106.9,
                "location_text", "Test Street 1, UB",
                "scheduled_at", future(),
                "draft_id", draftId,
                "intake_answers", CLEANING_INTAKE_ANSWERS,
