    visible:
      - COMP-MODALSHEET
    hidden:
      - COMP-SPLITCARD
      - COMP-PROFILEAVATAR
      - COMP-BUTTON
      - COMP-ANIMATEDCHECKMARK
  - id: expired_5min
    description: 5-minute response window expired; match auto-declined
    visible:
      - COMP-MODALSHEET
    hidden:
      - COMP-SPLITCARD
      - COMP-PROFILEAVATAR
      - COMP-BUTTON
      - COMP-ANIMATEDCHECKMARK
copy:
  - key: sheet_title
    mn: Шинэ санал!
    en: New match!
  - key: match_description
    mn: Танд шинэ шууд холболтын санал ирлээ. 5 минутын дотор хариулна уу
