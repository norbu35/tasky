    data_deps: [payment_id, qpay_qr, payment_status]

  SCR-P2-003:
    label: "Transaction History"
    edges:
      - to: SCR-P2-001
        type: pop
        guard: "back"
    data_deps: [credit_transactions]

  SCR-P2-004:
    label: "Low Balance Alert"
    edges:
      - to: SCR-P2-001
        type: push
        guard: "tap 'Buy Credits'"
      - to: "$previous"
        type: dismiss
        guard: "dismissed"
    data_deps: [credit_balance]

  SCR-P2-005:
    label: "Referral"
    edges:
      - to: "$previous"
        type: pop
        guard: "back"
    data_deps: [referral_code, referral_stats]

  # ═══════════════════════════════════════════════════
  # PHASE 3+ SCREENS
  # ═══════════════════════════════════════════════════

  SCR-P3-001:
    label: "Wallet"
    edges:
      - to: SCR-P3-002
        type: push
        guard: "tap 'Request Payout'"
    data_deps: [wallet_balance, wallet_transactions]

  SCR-P3-002:
    label: "Request Payout"
    edges:
      - to: SCR-P3-001
        type: pop
        guard: "submitted or back"
    data_deps: [wallet_balance, payout_schedule]

  SCR-P3-003:
    label: "Escrow Payment"
    edges:
      - to: SCR-CUST-017
        type: pop
        guard: "payment complete or back"
    data_deps: [booking_id, escrow_amount, qpay_qr]

  SCR-P3-004:
    label: "Tasker Pro Subscription"
    edges:
      - to: "$previous"
        type: pop
        guard: "back"
    data_deps: [subscription_plans, pro_badge_status, current_subscription]

  SCR-P3-005:
    label: "Instant Match (Tasker)"
    edges:
      - to: SCR-TASK-012
        type: dismiss
        guard: "accepted or declined"
    data_deps: [task_id, match_details]

