# Screen Spec: Escrow — Payment Flow
screen_id: SCR-P3-003
name: "Escrow — Payment Flow"
route: "/(customer)/bookings/:bookingId/escrow"
role: [customer]
phase: "3+"
template: detail
figma_page: "Phase 3+/Escrow Payment"
feature: "escrow"

layout:
  template: detail
  density: default
  structure: "safe_area -> nav_header -> scrollview(escrow_info + payment_section) -> sticky_bottom_cta"

components:
  - id: COMP-CARD
    usage: "Information card explaining escrow concept and benefits to the customer"
    props:
      onPress: null
    variant: elevated

  - id: COMP-CARD
    usage: "QPay QR code card for escrow payment (reused from credits payment pattern)"
    props:
      onPress: null
    variant: elevated

  - id: COMP-BUTTON
    usage: "Primary CTA for opt-in to escrow or QPay deeplink"
    props:
      label: "Эскроу ашиглах"
      variant: primary
      size: lg
    variant: primary

  - id: COMP-BUTTON
    usage: "Secondary skip button for opt-in prompt"
    props:
      label: "Үгүй, алгасах"
      variant: ghost
      size: md
    variant: ghost

  - id: COMP-STATUSBADGE
    usage: "Badge showing escrow payment status (pending, held, released)"
    props:
      status: "assigned"
    variant: assigned

  - id: COMP-ANIMATEDCHECKMARK
    usage: "Success animation when escrow payment is confirmed"
    props:
      size: 64
      color: "verified"
    variant: default

  - id: COMP-EMPTYSTATE
    usage: "Error state when escrow payment fails"
    props:
      illustration: "payment_failed"
      headline: "Төлбөр амжилтгүй"
      description: "Эскроу төлбөр хийхэд алдаа гарлаа"
      ctaLabel: "Дахин оролдох"
    variant: error

states:
  - id: opt_in_prompt
    description: "Customer is offered the option to use escrow payment for this booking"
    components_visible: [COMP-CARD, COMP-BUTTON.primary, COMP-BUTTON.ghost]
    components_hidden: [COMP-STATUSBADGE, COMP-ANIMATEDCHECKMARK, COMP-EMPTYSTATE]

  - id: qpay_payment
