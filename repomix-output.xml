    props:
      label: "Гараар засах"
      variant: ghost
      size: md
    variant: ghost

  - id: COMP-LOADINGSKELETON
    usage: "Skeleton for suggestion card while profile data or generation result is loading"
    props:
      variant: detail
      count: 1
    variant: detail

  - id: COMP-TOAST
    usage: "Success and error toast for apply/save outcomes"
    props:
      message: "Санал болгосон текст хадгалагдлаа"
