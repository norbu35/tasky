    user: ${POSTGRES_USER}
    password: ${POSTGRES_PASSWORD}

tasky:
  dev-auth:
    enabled: false
  auth:
    otp-test-code: ""
  storage:
    endpoint: ${MINIO_ENDPOINT}
    access-key: ${MINIO_ACCESS_KEY}
    secret-key: ${MINIO_SECRET_KEY}
    bucket: ${MINIO_BUCKET}
  push:
    provider: ${TASKY_PUSH_PROVIDER:firebase}
  features:
    data-retention-dry-run: false
