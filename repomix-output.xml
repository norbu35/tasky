    mn: "Санал хүлээн авсан"
    en: "Lead unlocked"
    max_chars: 25

  - key: type_refund
    mn: "Буцаалт"
    en: "Refund"
    max_chars: 15

  - key: credit_added
    mn: "+{count} кредит"
    en: "+{count} credits"
    max_chars: 15

  - key: credit_spent
    mn: "-{count} кредит"
    en: "-{count} credits"
    max_chars: 15

  - key: empty_headline
    mn: "Гүйлгээ байхгүй"
    en: "No transactions"
    max_chars: 25

  - key: empty_description
    mn: "Кредит худалдаж авсны дараа гүйлгээний түүх энд харагдана"
    en: "Transaction history will appear here after your first purchase"
    max_chars: 80

  - key: empty_cta
    mn: "Кредит авах"
    en: "Buy credits"
    max_chars: 20

  - key: error_headline
    mn: "Ачааллах боломжгүй"
    en: "Unable to load"
    max_chars: 30

  - key: error_retry
    mn: "Дахин оролдох"
    en: "Try again"
    max_chars: 20

api_endpoints:
