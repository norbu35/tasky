            {t('customer.cancelBooking.warning')}
          </Text>
          <Button
            label={t('customer.cancelBooking.confirm')}
            variant="destructive"
            onPress={() => void handleCancel()}
            isLoading={isPending}
            className="self-stretch"
          />
          <Button
            label={t('common.goBack')}
            variant="ghost"
            onPress={() => {
              setIsOpen(false);
              router.back();
            }}
            disabled={isPending}
            className="self-stretch"
          />
        </View>
      </ModalSheetTemplate>
    </ScreenContainer>
  );
}
