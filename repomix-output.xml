        }}
      >
        <Text className="text-body" style={{ color: colors.textSecondary, lineHeight: 24 }}>
          {t('auth.roleSelection.confirmSheetMessage', {
            role: roleLabel,
            defaultValue: `${roleLabel} болохоо баталгаажуулна уу. Тохиргооноос дараа солих боломжтой.`,
          })}
