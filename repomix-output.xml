      description: Returns paginated active service categories, sorted by `sort_order`.
      operationId: listCategories
      security:
        - BearerAuth: [ ]
      parameters:
        - $ref: '#/components/parameters/CursorParam'
        - $ref: '#/components/parameters/LimitParam'
      responses:
        '200':
          description: Paginated list of active categories.
          content:
            application/json:
              schema:
                type: object
                required: [ data, cursor ]
                properties:
                  data:
                    type: array
                    items:
                      $ref: '#/components/schemas/Category'
                  cursor:
                    $ref: '#/components/schemas/CursorPagination'
        '401':
          $ref: '#/components/responses/Unauthorized'

  /tasks/drafts:
    post:
      tags: [ Tasks ]
      summary: Create task draft
      description: |
