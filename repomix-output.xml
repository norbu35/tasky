    components_visible: [COMP-STATUSBADGE]
    components_hidden: [COMP-CARD, COMP-BUTTON, COMP-ANIMATEDCHECKMARK, COMP-EMPTYSTATE]

  - id: escrowed_confirmation
    description: "Payment confirmed; funds held in escrow until task completion"
    components_visible: [COMP-ANIMATEDCHECKMARK, COMP-STATUSBADGE, COMP-BUTTON.ghost]
    components_hidden: [COMP-CARD, COMP-BUTTON.primary, COMP-EMPTYSTATE]

  - id: error_payment_failed
    description: "QPay payment failed or was rejected"
    components_visible: [COMP-EMPTYSTATE, COMP-BUTTON.ghost]
    components_hidden: [COMP-CARD, COMP-STATUSBADGE, COMP-ANIMATEDCHECKMARK, COMP-BUTTON.primary]

copy:
  - key: nav_title
    mn: "Эскроу төлбөр"
    en: "Escrow Payment"
    max_chars: 20

  - key: opt_in_heading
    mn: "Эскроу төлбөрөөр хамгаалалт нэмэх"
