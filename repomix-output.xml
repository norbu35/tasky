      </ScrollView>

      {status === 'confirming' ? (
        <View className="p-xl gap-md bg-background" testID="subscription-confirm-sheet">
          <Text className="text-title font-bold text-primaryDeep">
            {t('tasker.subscription.confirmTitle')}
