<file path="research/unegui-scraper/scrape-unegui-cron.sh">
#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# Cron wrapper for Unegui.mn scraper — runs incremental scrape daily.
#
# Setup:
#   1. pip install -r scripts/requirements-scraper.txt && playwright install chromium
#   2. chmod +x scripts/scrape-unegui-cron.sh
#   3. Add cron entry (daily at 3 AM):
#        0 3 * * * /absolute/path/to/tasky/scripts/scrape-unegui-cron.sh
# ---------------------------------------------------------------------------
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_DIR="$SCRIPT_DIR/../market-data/unegui/logs"
mkdir -p "$LOG_DIR"
