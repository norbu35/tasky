  raised_by: 'u-customer-2',
  reason: 'Work quality was poor',
  status: 'OPEN',
  created_at: '2026-03-21T14:30:00Z',
};

const BOOKING_1: Booking = {
  id: 'b-001',
  task_id: 't-001',
  tasker_id: 'u-tasker-1',
  customer_id: 'u-customer-1',
  price: 50000,
  status: 'ASSIGNED',
  confirmed_scheduled_at: '2026-03-18T09:00:00Z',
