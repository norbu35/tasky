      - COMP-STATUSBADGE
      - COMP-TIMELINEEVENT
    hidden:
      - COMP-LOADINGSKELETON
      - COMP-TOAST
  - id: error_network
    description: Network error on data fetch; error toast with retry
    visible:
      - COMP-TOAST
    hidden:
      - COMP-PROFILEAVATAR
      - COMP-STATUSBADGE
      - COMP-BUTTON
      - COMP-TIMELINEEVENT
      - COMP-LOADINGSKELETON
copy:
  - key: page_title
    mn: Захиалгын дэлгэрэнгүй
    en: Booking Detail
