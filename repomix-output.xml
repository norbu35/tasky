  - id: COMP-STARRATING
    usage: "Interactive star rating input for communication dimension"
    props:
      value: 0
      onChange: "handleCommunicationRating"
      readonly: false
      size: lg
    variant: input

  - id: COMP-FORMFIELD
    usage: "Wrapper for optional freetext review comment"
