# Screen Spec: Reschedule
screen_id: SCR-CUST-020
name: "Reschedule"
route: "/(customer)/bookings/:bookingId/reschedule"
role: [customer]
phase: "0-1"
template: form_wizard
figma_page: "Customer/Reschedule"
feature: "booking"

layout:
  template: form_wizard
  density: default
  structure: "safe_area -> nav_header(back + title) -> scrollview(current_schedule + new_date_picker + reason_field) -> bottom_nav(back + submit)"

components:
  - id: COMP-DATEPICKER
    usage: "Date and time picker for proposed new schedule"
    props:
      value: null
      minDate: "tomorrow"
      mode: date_time
    variant: date_time

  - id: COMP-FORMFIELD
    usage: "Wrapper for reason text input with label and optional helper text"
    props:
      label: "Шалтгаан"
      required: false
      helperText: "Заавал биш"
    variant: default

  - id: COMP-INPUT
    usage: "Optional reason text field for the reschedule request"
    props:
      placeholder: "Цаг өөрчлөх шалтгаан..."
      maxLength: 200
    variant: multiline

  - id: COMP-BUTTON
    usage: "Submit button to send reschedule request; back button to return"
    props:
      label: "Хүсэлт илгээх"
      variant: primary
      size: lg
      loading: false
    variant: primary

  - id: COMP-STATUSBADGE
    usage: "Status indicator for reschedule request state (awaiting, accepted, declined, expired)"
    props:
      status: open
      size: sm
    variant: open

states:
