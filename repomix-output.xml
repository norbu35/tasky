                : requestState === 'accepted'
                  ? t('RescheduleScreen.acceptedMessage')
                  : requestState === 'declined'
                    ? t('RescheduleScreen.declinedMessage')
                    : t('RescheduleScreen.expiredMessage')}
            </Text>
          </View>
