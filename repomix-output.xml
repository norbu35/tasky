  - id: JRN-CUST-06
    name: "Raise & Track Dispute"
    actor: [customer]
    phase: "0-1"
    goal: "Report an issue with a booking"
    entry: SCR-CUST-017
    exit: [SCR-CUST-025]
    happy_path:
      - step: 1
        screen: SCR-CUST-017
        action: "Tap 'Report Issue'"
        next: SCR-CUST-024
      - step: 2
        screen: SCR-CUST-024
        action: "Submit dispute with evidence"
        next: SCR-CUST-025
        lifecycle: "DISP-T01 (party_raises_dispute)"
      - step: 3
        screen: SCR-CUST-025
        action: "Track dispute status"
        next: SCR-CUST-025
